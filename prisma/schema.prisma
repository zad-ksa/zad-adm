  charityName     String
  surveyType      String // "READINESS" or "HEXAGONAL" or "VISION_MISSION"
  isActive        Boolean  @default(true)
  customQuestions Json?
  createdAt       DateTime @default(now())
}

model Regulation {
  id                  String                        @id @default(uuid())
  title               String
  description         String?
  category            String // "الإشراف والحوكمة" or "التحول الرقمي" or "القطاع غير الربحي"
  link                String
