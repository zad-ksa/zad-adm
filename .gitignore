# فيقرأ حزمه الثنائية ويُولّد منها أصنافاً مشوّهة تُسقط ترجمة CSS.
/.next-*/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

