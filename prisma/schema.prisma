generator client {
  provider = "prisma-client-js"

  /// relationJoins: يجعل findMany مع include استعلاماً واحداً بـ LATERAL JOIN
  /// بدل استعلام منفصل لكل علاقة.
  ///
  /// قياس فعلي على صفحة الاعتمادات: الاستدعاء الواحد كان يتحوّل إلى 9 رحلات
  /// إلى القاعدة. زمن SQL نفسه 0.17 مللي، لكن القاعدة في سيدني فالرحلة الواحدة
  /// تكلّف مئات المللي — والتسع تُضرب في ذلك. بعد التفعيل: رحلة واحدة،
  /// والوسيط نزل من 1564 مللي إلى 319.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum CharitySize {
  MICRO // متناهية الصغر
  SMALL // صغيرة
  MEDIUM // متوسطة
  LARGE // كبيرة
  MEGA // متناهية الكبر
}

model Charity {
  id                String    @id @default(uuid())
  name              String    @unique
  establishmentDate String?
  licenseNumber     String?
  logoUrl           String?
  domain            String?
  createdAt         DateTime  @default(now())
  programs          Program[]

  // Financial fields
  contractValue        Float                 @default(0)
  paidAmount           Float                 @default(0)
  grants               Float                 @default(0)
  financialLogs        FinancialLog[]
  contractInstallments ContractInstallment[]
  meetings             Meeting[]

  // Timeline Configurations
  strategyTimelineName String? @default("التخطيط الاستراتيجي")
  strategyTimelineDept String? @default("STRATEGY")

  governanceTimelineName String? @default("الحوكمة")
  governanceTimelineDept String? @default("GOVERNANCE")

  financeTimelineName String? @default("تنمية الموارد المالية")
  financeTimelineDept String? @default("FINANCE")

  // Core pillars manual contact info
  strategyResponsibleName    String?
  strategyResponsiblePhone   String?
  governanceResponsibleName  String?
  governanceResponsiblePhone String?
  financeResponsibleName     String?
  financeResponsiblePhone    String?

  // Contact Info
  email         String?
  phone         String?
  chairmanName  String?
  chairmanPhone String?
  ceoName       String?
  ceoPhone      String?

  regulationVisibilities CharityRegulationVisibility[]
  employees              Employee[]
  assignedEmployees      EmployeeCharity[]             @relation("AssignedEmployees")
  serviceAccessGrants    EmployeeServiceAccess[]
  isReadinessVisible     Boolean                       @default(false)
  isVisionMissionVisible Boolean                       @default(false)
  isPerformanceEditable  Boolean                       @default(false)
  size                   CharitySize?
  annualRevenue          Float?
  services               Service[]
  visionMissionResponses VisionMissionResponse[]
  governanceProgress     GovernanceProgress[]
  donorAccounts          DonorAccount[]
  grantApplications      GrantApplication[]
  charityUsers           CharityUserCharity[]
  mails                  InternalMail[]                @relation("CharityMails")
  /// تعميد الصادر من هذه الجمعية: لكل جمعية أن تُفعّله أو تُرسل بلا تعميد.
  mailRequiresApproval   Boolean                       @default(false)
  mailApprovers          CharityMailApprover[]
  designRequests         DesignRequest[]

  // Attendance
  workSites         CharityWorkSite[]
  workSchedule      CharityWorkSchedule?
  attendanceRecords AttendanceRecord[]
  employeeLeaves    EmployeeLeave[]

  // Optional second factor for attendance: the public IPs / CIDR ranges of the
  // charity's own network. Empty list = layer off. Browser GPS is trivially
  // spoofable from DevTools; network origin is not, so this is the stronger of
  // the two signals. See IpEnforcementMode for what a mismatch does.
  allowedIpRanges String[]          @default([])
  ipEnforcement   IpEnforcementMode @default(OFF)

  projectBuilderProfile   ProjectBuilderCharityProfile?
  projectBuilderDocuments ProjectBuilderDocument[]

  /// كيانٌ داخليٌّ لا جمعيةً متعاقدة — «شركة زاد» نفسها.
  ///
  /// زاد تحتاج ما تحتاجه الجمعية في الاستراتيجية وتنمية الموارد: أهدافاً
  /// ومؤشرات ومبادراتٍ ومنحاً. وكلّها مربوطةٌ بـcharityId إلزامياً، فصفٌّ
  /// حقيقيٌّ يُشغّلها بلا تعديل — بخلاف charityId=null في DesignRequest،
  /// الذي يكسر القيود الفريدة (NULL ≠ NULL في Postgres) ويُنسى شرطُه.
  ///
  /// وثمنُه أن يُستثنى من قوائم الجمعيات التي لا يخصّها: العقود وحسابات
  /// البوّابة والمحاضر والاستبيانات وغيرها. فالاستثناء في موضعٍ واحد:
  /// EXTERNAL_CHARITIES في src/lib/charityScope.ts.
  isInternal              Boolean               @default(false)
  // التخطيط الاستراتيجي — docs/خطة-نظام-التخطيط-الاستراتيجي.md
  /// حالة الخطة الاستراتيجية: اختيارٌ يدويٌّ من StrategyStatusOption، لا محسوبة.
  /// نصُّ الحالة لا مفتاحها، كي لا يختفي تاريخُ جمعيةٍ إذا حُذف خيارٌ من القائمة.
  strategyStatus          String?
  strategyStatusUpdatedAt DateTime?
  /// مفاتيح إظهارٍ لبوّابة الجمعية — مُهيَّأة لا مستعملة بعد.
  isObjectivesVisible     Boolean               @default(false)
  isOperationalVisible    Boolean               @default(false)
  strategyPerspectives    StrategyPerspective[]
  operationalPlans        OperationalPlan[]
}

/// معلومات الجمعية الثابتة لمنشئ وثائق المبادرات — رؤيتها، رسالتها، مجالها
/// ومدينتها. يُعبّئها مرّةً من يحمل صلاحية "manage_project_builder" فتُملأ
/// تلقائياً عند اختيار الجمعية في الأداة، ولا يعدّلها أحدٌ غيره لاحقاً — هذا هو
/// القصد: نصّ موحّد لكل وثيقة تُولَّد لهذه الجمعية، لا صياغة جديدة من كل موظف.
model ProjectBuilderCharityProfile {
  id             String   @id @default(uuid())
  charityId      String   @unique
  charity        Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  vision         String?
  mission        String?
  strategicGoals String?
  field          String?
  city           String?
  updatedAt      DateTime @updatedAt
  updatedById    String?
}

/// سجل إصدارات البرومبت العام لمنشئ وثائق المبادرات — بلا تحديث فوق صفّ قائم.
/// كل حفظ يُضيف صفّاً جديداً، فيبقى كل إصدار سابق قابلاً للاستعراض أو
/// الاستعادة، ومن حفظه ومتى. "الحالي" هو الأحدث بـcreatedAt.
model ProjectBuilderPromptVersion {
  id            String   @id @default(uuid())
  template      String
  createdAt     DateTime @default(now())
  createdById   String?
  createdByName String?
  /// ملاحظة اختيارية — تُعبَّأ تلقائياً عند "استعادة إصدار" لتوثيق السبب.
  note          String?

  @@index([createdAt])
}

/// وثيقة مبادرة محفوظة من موظف — سجلّه الخاص وحده، لا سجلّ مشترك. يحفظها بإرادته
/// (ليس كل مولَّد تلقائياً، فلا يمتلئ السجلّ بمسوّدات لم تُعتمد)، ويملك تعديلها
/// أو حذفها لاحقاً. history محادثة التوليد — تتيح استئناف التعديل بالذكاء
/// الاصطناعي عند إعادة فتحها، لا إعادة بناء البرومبت من الصفر.
model ProjectBuilderDocument {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  charityId  String
  charity    Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  title      String
  content    String
  history    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@index([charityId])
}

// ── حسابات وبوابة الجمعيات ──────────────────────────────────────────────────────────

enum CharityUserTitle {
  CHAIRMAN // رئيس مجلس إدارة
  CEO // مدير تنفيذي
  FULL_TIME // موظف بدوام كامل
  PART_TIME // موظف بداوم جزئي
  VOLUNTEER // متطوع
  SYSTEM_ADMIN // مدير النظام
}

model CharityUser {
  id          String           @id @default(uuid())
  name        String
  phone       String           @unique
  /// Login email and bcrypt hash — both optional, both meaningless alone.
  /// See the note on Employee.email.
  email       String?          @unique
  password    String?
  title       CharityUserTitle @default(FULL_TIME)
  permissions String[]         @default([])
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  charities         CharityUserCharity[]
  sentMails         InternalMail[]        @relation("CharitySentMails")
  receivedMails     MailRecipient[]       @relation("CharityReceivedMails")
  mailApprovals     CharityMailApprover[]
  designRequests    DesignRequest[]       @relation("SubmittedDesignRequests")
  attendanceRecords AttendanceRecord[]
  leaves            EmployeeLeave[]
}

model CharityUserCharity {
  id            String      @id @default(uuid())
  charityUserId String
  charityId     String
  user          CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charity       Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  // Permissions are scoped PER CHARITY, not per user. CharityUser.permissions
  // (left on the model, now unused) could not express "HR manager in charity A,
  // ordinary staff in charity B" — one array travelled with the account into
  // every charity it was linked to, which is a privilege leak.
  permissions String[] @default([])

  // Membership is deactivated PER CHARITY, never by deleting the row and never
  // via the account-wide CharityUser.isActive: an account may serve several
  // charities, so charity A removing someone must not lock them out of charity
  // B. Keeping the row (rather than deleting it) preserves who they were and
  // what they held, alongside their attendance history.
  isActive Boolean @default(true)

  // Administrator OF THIS CHARITY — the blanket "may do anything here" flag.
  //
  // This lives on the link for the same reason `permissions` does. It used to be
  // read from CharityUser.title == "SYSTEM_ADMIN", which is stored per ACCOUNT:
  // an account serving two charities was therefore an administrator of both at
  // once, and either charity could grant or revoke that standing for the other
  // — charity B promoting a shared member handed them full authority over
  // charity A, and demoting them stripped charity A of its administrator.
  //
  // The title stays on the account as a job label (CEO, chairman, volunteer …)
  // and now carries no authority of its own.
  isAdmin Boolean @default(false)

  /// تجاوز رصيد الإجازة السنوية لهذا الموظف في هذه الجمعية. `null` يعني اتّباع
  /// رصيد الجمعية الافتراضي. على الرابط لا على الحساب، فلكل جمعية رصيدها.
  annualLeaveDays Int?

  /// الخدمات المفوَّض لها هذا العضو في هذه الجمعية.
  services CharityMemberService[]

  @@unique([charityUserId, charityId])
  @@index([charityUserId])
  @@index([charityId])
}

model EmployeeNavSetting {
  id         String   @id @default(uuid())
  employeeId String   @unique
  settings   Json
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model GovernanceProgress {
  id            String   @id @default(uuid())
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  indicatorId   String // The ID of the indicator from the static JSON
  status        String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  proofUrl      String?
  proofPublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([charityId, indicatorId])
  @@index([charityId])
}

model Meeting {
  id               String        @id @default(uuid())
  title            String
  date             DateTime
  meetingNumber    Int?
  location         String?
  charityId        String?
  charity          Charity?      @relation(fields: [charityId], references: [id], onDelete: SetNull)
  meetingContext   String?
  rawNotes         String        @db.Text
  formattedContent String        @db.Text
  summary          String?       @db.Text
  attendees        String?
  isPrivate        Boolean       @default(false)
  createdById      String
  createdBy        Employee      @relation("MeetingCreator", fields: [createdById], references: [id])
  meetingTasks     MeetingTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdById])
  @@index([charityId])
}

model MeetingTask {
  id           String    @id @default(uuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title        String
  assignedToId String?
  assignedTo   Employee? @relation("MeetingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDays      Int?
  dueDate      DateTime?
  isDone       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  task Task?

  @@index([meetingId])
}

model FinancialLog {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  type      String // "CONTRACT_UPDATE" | "PAID_UPDATE" | "ADD_GRANT" | "DISBURSEMENT"
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}

/// الجهةُ المانحة كيانٌ واحدٌ للموقع كلِّه، لا نصٌّ مُعادٌ في كل جمعية.
///
/// كان اسمُها نصّاً حرّاً في `DonorAccount.donorName` و`GrantApplication.entityName`،
/// فصار في القاعدة «بنك الجزيرة» و«بنك الجزيرة␣» بُعدين برمزين، و«منصة إحسان»
/// و«منصة احسان» جهتين في الجدول وواحدةً في الواقع. وسؤالٌ كـ«كم جمعيةً رفعت
/// لهذه الجهة» لا يُحسب على نصٍّ يُكتب كلَّ مرّةٍ بهجاءٍ آخر.
///
/// وهي ليست `Charity`: لا حسابَ دخولٍ لها ولا خدماتٍ تُشترى، وإنما جهةٌ تُرفع
/// إليها المنح.
model DonorOrg {
  id   String  @id @default(uuid())
  name String  @unique
  /// رابطُ بوّابة الجهة.
  url  String?
  /// مجالاتُ الدعم: نصٌّ واحدٌ كما كُتب في ملف الجهات، لا وسومٌ مُعدّة —
  /// فالمصدرُ جملٌ لا قوائم، وتقطيعُها وسوماً تخمينٌ يَضيع فيه المعنى.
  fields String?

  /// FOUNDATION | EHSAN | CHARITY_FUND — تبويبٌ لكل نوع.
  ///
  /// حقلٌ لا ثلاثةُ جداول: الثلاثةُ ثلاثُ واجهاتٍ لشيءٍ واحد (جهةٌ لها رابطٌ
  /// وحساباتٌ ومنحٌ مرفوعة)، والمنحةُ تُشير إلى جهةٍ واحدةٍ أيّاً كان نوعُها.
  kind String @default("FOUNDATION")

  /// OPEN | CLOSED — حالةُ الرفع، صريحةٌ يضبطها الموظف.
  ///
  /// ولا تُشتقّ من التاريخين: جهةٌ تُفتح بلا تاريخٍ معلن، وأخرى تُغلق قبل
  /// موعدها. والتاريخانِ بيانٌ معلن، وإن خالفا الحالةَ قيل ذلك سطراً هادئاً
  /// (`intakeDateNote`) ولم تُقلب الشارة.
  intakeStatus String    @default("CLOSED")
  opensAt      DateTime?
  closesAt     DateTime?
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts DonorAccount[]
  grants   GrantApplication[]

  @@index([kind, name])
}

model DonorAccount {
  id         String   @id @default(uuid())
  charityId  String
  charity    Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  donorOrgId String
  /// `Restrict` لا `Cascade`: حذفُ جهةٍ لا يَجرُف حساباتِ عشرِ جمعياتٍ
  /// وكلماتَ مرورها معها.
  donorOrg   DonorOrg @relation(fields: [donorOrgId], references: [id], onDelete: Restrict)
  username   String
  password   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /// حسابٌ واحدٌ لكل جمعيةٍ عند كل جهة — فجدولُ الحسابات صفٌّ لكل جمعية.
  @@unique([donorOrgId, charityId])
  @@index([charityId])
}

model GrantApplication {
  id                 String    @id @default(uuid())
  charityId          String
  charity            Charity   @relation(fields: [charityId], references: [id], onDelete: Cascade)
  donorOrgId         String?
  donorOrg           DonorOrg? @relation(fields: [donorOrgId], references: [id], onDelete: Restrict)
  /// اسمُ الجهة وقت الرفع، مثبَّتاً في الصفّ.
  ///
  /// لا يُحذف وإن صارت الجهةُ صفّاً: المنحةُ وثيقةٌ رُفعت في تاريخٍ معلوم،
  /// وإعادةُ تسمية الجهة لاحقاً لا يجوز أن تُعيد كتابة ما رُفع. وهو نفسُ ما
  /// فُعل في `FinancialRequest.typeLabel`.
  entityName         String    @default("غير محدد")
  initiativeName     String
  requestedAmount    Float
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CLOSED"
  installmentsCount  Int?
  installmentsNotes  String?
  beneficiariesCount Int?
  collectedAmount    Float?
  closureDate        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([charityId])
  /// صفحةُ الجهة تسأل: منحُ هذه الجهة من جمعياتٍ بعينها.
  @@index([donorOrgId, charityId])
}

model Program {
  id            String   @id @default(uuid())
  name          String
  beneficiaries Int
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SurveyResponse {
  id                String   @id @default(uuid())
  charityName       String
  establishmentDate String
  licenseNumber     String
  authorizedName    String
  authorizedTitle   String
  scorePercentage   Int
  answers           Json
  createdAt         DateTime @default(now())
}

model HexagonalResponse {
  id              String   @id @default(uuid())
  charityName     String
  authorizedTitle String
  answers         Json
  createdAt       DateTime @default(now())
}

model PerformanceMetric {
  id          String   @id @default(uuid())
  charityName String
  year        Int
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([charityName, year])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String
  /// قالبٌ يُنسخ بفعلٍ صريح («مزامنة») فيدهس صلاحيات الموظف. ليس حيّاً: الجلسة
  /// لا تقرأه، ولذلك لا يكفي وحده لوصف ما يستطيعه صاحب المسمى. المجموعات أدناه
  /// هي الطريق الحيّ.
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bundles RoleBundle[]
}

/// مجموعة صلاحيات باسمٍ حرّ — اختصارٌ لعدّة صلاحيات، لا مسمّى وظيفي.
///
/// الفرق عن RoleDefinition جوهري لا تسمويّ:
///   • المسمى واحدٌ للموظف، والمجموعات عدّة.
///   • المسمى يُنسخ نسخاً عند المزامنة، والمجموعة تُقرأ حيّةً عند كل جلسة —
///     فتعديل المجموعة يسري على حامليها في اللحظة، بلا مزامنةٍ ولا دهس.
///   • المسمى يصف الوظيفة، والمجموعة تصف قدرةً («مسؤول التحضير» مثلاً) قد
///     يحملها أصحاب مسمّياتٍ شتّى.
model PermissionBundle {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  permissions String[] @default([])
  /// أسماء الخدمات التي تفتحها المجموعة في «عرض الخدمات». بالاسم لا بالمعرّف،
  /// لأن الخدمة الواحدة صفوفٌ عدّة — اسمٌ واحد في كل جمعية — وهو المفتاح الذي
  /// يستعمله EmployeeServiceAccess أصلاً.
  services    String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  employees EmployeeBundle[]
  roles     RoleBundle[]
}

/// منح مجموعة لموظف بعينه. المفتاح مركّب، فالمنح الواحد لا يتكرّر.
model EmployeeBundle {
  employeeId String
  bundleId   String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  bundle     PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  grantedAt  DateTime         @default(now())

  @@id([employeeId, bundleId])
  @@index([bundleId])
}

/// ربط مجموعة بمسمّى وظيفي: يسري على كل من يحمل المسمى، حيّاً بلا مزامنة.
model RoleBundle {
  roleId   String
  bundleId String
  role     RoleDefinition   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  bundle   PermissionBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@id([roleId, bundleId])
  @@index([bundleId])
}

model Employee {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  /// Login email. Optional on purpose: an account without one still signs in
  /// with phone + OTP exactly as before, so no migration can lock anyone out.
  email       String?  @unique
  /// bcrypt hash. null means this person has not set up email login yet.
  password    String?
  avatarUrl   String?
  role        String   @default("STRATEGY")
  charityId   String? // For CHARITY_CLIENT accounts
  charity     Charity? @relation(fields: [charityId], references: [id])
  permissions String[]
  navOrder    String[] @default([])
  isActive    Boolean  @default(true)

  // ── التحضير ───────────────────────────────────────────────────────────
  /// Which shift this person works. Null falls back to the default group —
  /// see zadAttendance.ts. A single field rather than a join table because a
  /// person has ONE working day at a time; two rows would leave "which one
  /// applies?" with no answer.
  shiftGroupId String?
  shiftGroup   ZadShiftGroup? @relation(fields: [shiftGroupId], references: [id], onDelete: SetNull)

  /// Annual leave entitlement in days. On the person, not the company:
  /// seniority and contract change it, and one company-wide number would be
  /// a lie on the first exception.
  annualLeaveDays Int @default(21)

  /// Lets this person record attendance from outside every work site.
  /// The geofence is mandatory by default; this is the deliberate, per-person
  /// exemption rather than a hole in the rule.
  remoteWorkAllowed Boolean @default(false)

  zadAttendance           ZadAttendanceRecord[]
  zadLeaves               ZadEmployeeLeave[]
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  assignedTasks           Task[]                   @relation("AssignedTasks")
  createdTasks            Task[]                   @relation("CreatedTasks")
  assignedPermanentTasks  PermanentTask[]          @relation("AssignedPermanentTasks")
  createdPermanentTasks   PermanentTask[]          @relation("CreatedPermanentTasks")
  employeeAchievements    Achievement[]            @relation("EmployeeAchievements")
  createdAchievements     Achievement[]            @relation("CreatedAchievements")
  assignedCharities       EmployeeCharity[]        @relation("AssignedCharities")
  serviceAccess           EmployeeServiceAccess[]
  bundles                 EmployeeBundle[]
  appNotifications        AppNotification[]
  createdMeetings         Meeting[]                @relation("MeetingCreator")
  meetingTasksAssigned    MeetingTask[]            @relation("MeetingTaskAssignee")
  navSetting              EmployeeNavSetting?
  createdRequests         Request[]                @relation("CreatedRequests")
  reviewedRequests        Request[]                @relation("ReviewedRequests")
  requestNotifications    RequestNotification[]    @relation("RequestNotifications")
  workflowSteps           WorkflowStep[]           @relation("WorkflowStepApprover")
  requestLogs             RequestLog[]             @relation("LogActor")
  delegatedLogs           RequestLog[]             @relation("LogDelegatee")
  currentlyReviewing      Request[]                @relation("CurrentReviewer")
  delegatedRequests       Request[]                @relation("DelegatedTo")
  createdMeetingSchedules MeetingSchedule[]        @relation("CreatedMeetingSchedules")
  sentMails               InternalMail[]           @relation("SentMails")
  receivedMails           MailRecipient[]          @relation("ReceivedMails")
  createdDesignRequests   DesignRequest[]          @relation("CreatedDesignRequests")
  completedDesignRequests DesignRequest[]          @relation("CompletedDesignRequests")
  startedDesignRequests   DesignRequest[]          @relation("StartedDesignRequests")
  reviewedDesignRequests  DesignRequest[]          @relation("ReviewedDesignRequests")
  templateNodes           TemplateNode[]           @relation("TemplateNodes")
  mailApprovals           MailApprover[]
  projectBuilderDocuments ProjectBuilderDocument[]
}

/// من يرى أي خدمة في «عرض الخدمات».
///
/// المفتاح هو اسم الخدمة لا معرّف صفّها: الخدمة الواحدة في الواجهة مجموعة صفوف
/// (صفٌّ لكل جمعية — تسعة أسماء × ثماني جمعيات اليوم)، ومعرّفات الصفوف تتغيّر
/// عند التوحيد بشهادة تعليقات الكود نفسه. الاسم هو ما يجمع به كلا الجانبين.
///
/// وغياب أي صفّ لموظف يعني «بلا تقييد» — يرى كل خدمات جمعياته المُسندة. هذا هو
/// نفس اصطلاح getAssignedCharityIds الذي يُرجع null بمعنى بلا تقييد، وهو ما
/// يجعل إضافة هذا الجدول لا تكسر أحداً: التقييد يبدأ عند أول منحة.
model EmployeeServiceAccess {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  serviceName String

  /// null = هذه الخدمة في كل جمعيات الموظف المُسندة، وهي الحالة الشائعة.
  /// وقيمة = هذه الخدمة في هذه الجمعية وحدها — لمن أراد نطاقاً أضيق من إسناده.
  charityId String?
  charity   Charity? @relation(fields: [charityId], references: [id], onDelete: Cascade)

  grantedAt DateTime @default(now())

  @@unique([employeeId, serviceName, charityId])
  @@index([employeeId])
  @@index([serviceName])
}

model EmployeeCharity {
  id         String   @id @default(uuid())
  employeeId String
  charityId  String
  employee   Employee @relation("AssignedCharities", fields: [employeeId], references: [id], onDelete: Cascade)
  charity    Charity  @relation("AssignedEmployees", fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([employeeId, charityId])
  @@index([employeeId])
  @@index([charityId])
}

model Task {
  id                 String       @id @default(uuid())
  title              String
  assignedToId       String
  assignedTo         Employee     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          Employee     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  charityId          String?
  charityName        String?
  isInternal         Boolean      @default(false)
  isCompleted        Boolean      @default(false)
  status             String       @default("NOT_STARTED") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  priority           Int          @default(3) // 1: High, 2: Medium, 3: Low
  completedAt        DateTime?
  /// Proof of COMPLETION, attached when the task is closed.
  proofUrl           String?
  proofPublicId      String?
  completionNote     String?      @db.Text
  /// An image attached when the task is CREATED — the brief, not the proof.
  /// Deliberately separate from proofUrl: one describes what to do, the
  /// other shows it was done, and overwriting the first with the second
  /// would erase the instructions at the moment they stop being needed.
  attachmentUrl      String?
  attachmentPublicId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  updates            TaskUpdate[]

  meetingTaskId String?      @unique
  meetingTask   MeetingTask? @relation(fields: [meetingTaskId], references: [id], onDelete: Cascade)

  @@index([assignedToId, isCompleted])
}

model TaskUpdate {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Achievement {
  id            String   @id @default(uuid())
  title         String
  employeeId    String
  employee      Employee @relation("EmployeeAchievements", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     Employee @relation("CreatedAchievements", fields: [createdById], references: [id], onDelete: Cascade)
  charityId     String?
  charityName   String?
  isInternal    Boolean  @default(false)
  proofUrl      String?
  proofPublicId String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
}

model News {
  id          String   @id @default(uuid())
  charityName String
  category    String
  title       String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([charityName])
}

model SurveyLink {
