generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum CharitySize {
  MICRO // متناهية الصغر
  SMALL // صغيرة
  MEDIUM // متوسطة
  LARGE // كبيرة
  MEGA // متناهية الكبر
}

model Charity {
  id                String    @id @default(uuid())
  name              String    @unique
  establishmentDate String?
  licenseNumber     String?
  logoUrl           String?
  domain            String?
  createdAt         DateTime  @default(now())
  programs          Program[]

  // Financial fields
  contractValue    Float             @default(0)
  paidAmount       Float             @default(0)
  grants           Float             @default(0)
  financialLogs    FinancialLog[]
  contractInstallments ContractInstallment[]
  meetings         Meeting[]

  // Timeline Configurations
  strategyTimelineName String? @default("التخطيط الاستراتيجي")
  strategyTimelineDept String? @default("STRATEGY")

  governanceTimelineName String? @default("الحوكمة")
  governanceTimelineDept String? @default("GOVERNANCE")

  financeTimelineName String? @default("تنمية الموارد المالية")
  financeTimelineDept String? @default("FINANCE")

  // Core pillars manual contact info
  strategyResponsibleName    String?
  strategyResponsiblePhone   String?
  governanceResponsibleName  String?
  governanceResponsiblePhone String?
  financeResponsibleName     String?
  financeResponsiblePhone    String?

  regulationVisibilities CharityRegulationVisibility[]
  employees              Employee[]
  assignedEmployees      EmployeeCharity[]             @relation("AssignedEmployees")
  isReadinessVisible     Boolean                       @default(false)
  isVisionMissionVisible Boolean                       @default(false)
  isPerformanceEditable  Boolean                       @default(false)
  size                   CharitySize?
  annualRevenue          Float?
  services               Service[]
  visionMissionResponses VisionMissionResponse[]
  governanceProgress     GovernanceProgress[]
  donorAccounts          DonorAccount[]
  grantApplications      GrantApplication[]
  charityUsers      CharityUserCharity[]
}

// ── حسابات وبوابة الجمعيات ──────────────────────────────────────────────────────────

enum CharityUserTitle {
  CHAIRMAN      // رئيس مجلس إدارة
  CEO           // مدير تنفيذي
  FULL_TIME     // موظف بدوام كامل
  PART_TIME     // موظف بداوم جزئي
  VOLUNTEER     // متطوع
}

model CharityUser {
  id          String   @id @default(uuid())
  name        String
  phone       String   @unique
  title       CharityUserTitle @default(FULL_TIME)
  permissions String[] @default([]) 
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  charities   CharityUserCharity[]
}

model CharityUserCharity {
  id            String   @id @default(uuid())
  charityUserId String
  charityId     String
  user          CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charity       Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt    DateTime @default(now())

  @@unique([charityUserId, charityId])
  @@index([charityUserId])
  @@index([charityId])
}

model EmployeeNavSetting {
  id         String   @id @default(uuid())
  employeeId String   @unique
  settings   Json
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model GovernanceProgress {
  id            String   @id @default(uuid())
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  indicatorId   String // The ID of the indicator from the static JSON
  status        String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  proofUrl      String?
  proofPublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([charityId, indicatorId])
  @@index([charityId])
}

model Meeting {
  id               String        @id @default(uuid())
  title            String
  date             DateTime
  meetingNumber    Int?
  location         String?
  charityId        String?
  charity          Charity?      @relation(fields: [charityId], references: [id], onDelete: SetNull)
  meetingContext   String?
  rawNotes         String        @db.Text
  formattedContent String        @db.Text
  summary          String?       @db.Text
  attendees        String?
  isPrivate        Boolean       @default(false)
  createdById      String
  createdBy        Employee      @relation("MeetingCreator", fields: [createdById], references: [id])
  meetingTasks     MeetingTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdById])
  @@index([charityId])
}

model MeetingTask {
  id           String    @id @default(uuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title        String
  assignedToId String?
  assignedTo   Employee? @relation("MeetingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDays      Int?
  dueDate      DateTime?
  isDone       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@index([meetingId])
}

model FinancialLog {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  type      String // "CONTRACT_UPDATE" | "PAID_UPDATE" | "ADD_GRANT" | "DISBURSEMENT"
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}

model DonorAccount {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  donorName String
  username  String
  password  String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([charityId])
}

model GrantApplication {
  id              String   @id @default(uuid())
  charityId       String
  charity         Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  entityName      String   @default("غير محدد")
  initiativeName  String
  requestedAmount Float
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CLOSED"
  installmentsCount  Int?
  installmentsNotes  String?
  beneficiariesCount Int?
  collectedAmount    Float?
  closureDate        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([charityId])
}

model Program {
  id            String   @id @default(uuid())
  name          String
  beneficiaries Int
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SurveyResponse {
  id                String   @id @default(uuid())
  charityName       String
  establishmentDate String
  licenseNumber     String
  authorizedName    String
  authorizedTitle   String
  scorePercentage   Int
  answers           Json
  createdAt         DateTime @default(now())
}

model HexagonalResponse {
  id              String   @id @default(uuid())
  charityName     String
  authorizedTitle String
  answers         Json
  createdAt       DateTime @default(now())
}

model PerformanceMetric {
  id          String   @id @default(uuid())
  charityName String
  year        Int
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([charityName, year])
}

enum Role {
  ADMIN
  EXECUTIVE_DIRECTOR
  GENERAL_MANAGER
  ADMINISTRATIVE_SECRETARIAT
  STRATEGY
  FINANCE
  CHARITY_CLIENT
}

model Employee {
  id                   String            @id @default(uuid())
  name                 String
  phone                String            @unique
  password             String
  avatarUrl            String?
  role                 Role              @default(STRATEGY)
  charityId            String? // For CHARITY_CLIENT accounts
  charity              Charity?          @relation(fields: [charityId], references: [id])
  permissions          String[]
  navOrder             String[]          @default([])
  isActive             Boolean           @default(true)
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  assignedTasks        Task[]            @relation("AssignedTasks")
  createdTasks         Task[]            @relation("CreatedTasks")
  employeeAchievements Achievement[]     @relation("EmployeeAchievements")
  createdAchievements  Achievement[]     @relation("CreatedAchievements")
  assignedCharities    EmployeeCharity[] @relation("AssignedCharities")
  createdMeetings      Meeting[]         @relation("MeetingCreator")
  meetingTasksAssigned MeetingTask[]     @relation("MeetingTaskAssignee")
  navSetting           EmployeeNavSetting?
  createdRequests      Request[]         @relation("CreatedRequests")
  reviewedRequests     Request[]         @relation("ReviewedRequests")
  requestNotifications RequestNotification[] @relation("RequestNotifications")
  workflowSteps        WorkflowStep[]    @relation("WorkflowStepApprover")
  requestLogs          RequestLog[]      @relation("LogActor")
  delegatedLogs        RequestLog[]      @relation("LogDelegatee")
  currentlyReviewing   Request[]         @relation("CurrentReviewer")
  delegatedRequests    Request[]         @relation("DelegatedTo")
}

model EmployeeCharity {
  id         String   @id @default(uuid())
  employeeId String
  charityId  String
  employee   Employee @relation("AssignedCharities", fields: [employeeId], references: [id], onDelete: Cascade)
  charity    Charity  @relation("AssignedEmployees", fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([employeeId, charityId])
  @@index([employeeId])
  @@index([charityId])
}

model Task {
  id            String       @id @default(uuid())
  title         String
  assignedToId  String
  assignedTo    Employee     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     Employee     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  charityId     String?
  charityName   String?
  isInternal    Boolean      @default(false)
  isCompleted   Boolean      @default(false)
  status        String       @default("NOT_STARTED") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  priority      Int          @default(3) // 1: High, 2: Medium, 3: Low
  completedAt   DateTime?
  proofUrl      String?
  proofPublicId String?
  completionNote String?       @db.Text
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  updates       TaskUpdate[]

  @@index([assignedToId, isCompleted])
}

model TaskUpdate {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Achievement {
  id            String   @id @default(uuid())
  title         String
  employeeId    String
  employee      Employee @relation("EmployeeAchievements", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     Employee @relation("CreatedAchievements", fields: [createdById], references: [id], onDelete: Cascade)
  charityId     String?
  charityName   String?
  isInternal    Boolean  @default(false)
  proofUrl      String?
  proofPublicId String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
}

model News {
  id          String   @id @default(uuid())
  charityName String
  category    String
  title       String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([charityName])
}

model SurveyLink {
  id              String   @id @default(uuid())
  charityName     String
  surveyType      String // "READINESS" or "HEXAGONAL" or "VISION_MISSION"
  isActive        Boolean  @default(true)
  customQuestions Json?
  createdAt       DateTime @default(now())
}

model Regulation {
  id                  String                        @id @default(uuid())
  title               String
  description         String?
  category            String // "الإشراف والحوكمة" or "التحول الرقمي" or "القطاع غير الربحي"
  link                String
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  charityVisibilities CharityRegulationVisibility[]
}

model CharityRegulationVisibility {
  id           String     @id @default(uuid())
  charityId    String
  regulationId String
  isVisible    Boolean    @default(true)
  charity      Charity    @relation(fields: [charityId], references: [id], onDelete: Cascade)
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([charityId, regulationId])
}

model ServiceTemplate {
  id         String         @id @default(uuid())
  name       String
  department String?
  stages     ServiceStageTemplate[]
  services   Service[]
  
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ServiceStageTemplate {
  id           String             @id @default(uuid())
  name         String
  description  String?
  duration     String?
  order        Int                @default(0)
  
  templateId   String
  template     ServiceTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model Service {
  id         String         @id @default(uuid())
  name       String
  department String?
  charityId  String
  charity    Charity        @relation(fields: [charityId], references: [id], onDelete: Cascade)
  
  templateId String?
  template   ServiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  stages     ServiceStage[]
  
  responsibleName  String?
  responsiblePhone String?

  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ServiceStage {
  id           String             @id @default(uuid())
  name         String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  duration     String?
  order        Int                @default(0)
  isCurrent    Boolean            @default(false)
  isContinuous Boolean            @default(false)
  isActive     Boolean            @default(true)
  isDone       Boolean            @default(false)
  
  templateId   String?
  
  serviceId    String
  service      Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  steps        ServiceStageStep[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model ServiceStageStep {
  id        String       @id @default(uuid())
  name      String
  isDone    Boolean      @default(false)
  startDate DateTime?
  endDate   DateTime?
  order     Int          @default(0)
  stageId   String
  stage     ServiceStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model CustomSurvey {
  id        String                 @id @default(uuid())
  slug      String?                @unique
  title     String
  introText String?
  isActive  Boolean                @default(false)
  sections  CustomSurveySection[]
  responses CustomSurveyResponse[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model CustomSurveySection {
  id        String                 @id @default(uuid())
  title     String
  order     Int
  surveyId  String
  survey    CustomSurvey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions CustomSurveyQuestion[]
}

model CustomSurveyQuestion {
  id                     String              @id @default(uuid())
  text                   String
  type                   String              @default("TEXT") // "TEXT", "MULTIPLE_CHOICE", "FILE"
  isRequired             Boolean             @default(true)
  allowAttachment        Boolean             @default(false)
  requireAttachmentIfYes Boolean             @default(false)
  options                Json? // Array of { id, text, score } — for YES_NO questions this instead stores { followUpQuestions: [...] }
  order                  Int
  sectionId              String
  section                CustomSurveySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model CustomSurveyResponse {
  id          String       @id @default(uuid())
  surveyId    String
  survey      CustomSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  charityName String // Charity name or other info collected
  answers     Json // Stores {"questionId": "answer or optionId"}
  attachments Json? // Stores {"questionId": "fileUrl"}
  createdAt   DateTime     @default(now())
}

model VisionMissionResponse {
  id              String   @id @default(uuid())
  charityId       String
  charity         Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  charityName     String
  respondentName  String
  respondentTitle String
  answers         Json
  createdAt       DateTime @default(now())
}

model AchievementCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Default stages template — used when creating a new charity or resetting stages
model DefaultStage {
  id           String   @id @default(uuid())
  timelineType String // 'STRATEGY' | 'GOVERNANCE' | 'FINANCE'
  name         String
  description  String?
  order        Int      @default(0)
  isContinuous Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([timelineType])
}

// Global timeline display names (shown in tabs and headers across the app)
model TimelineConfig {
  id           String   @id @default(uuid())
  timelineType String   @unique // 'STRATEGY' | 'GOVERNANCE' | 'FINANCE'
  displayName  String
  updatedAt    DateTime @updatedAt
}

// ── نظام الطلبات ──────────────────────────────────────────────────────────────

enum RequestStatus {
  PENDING    // قيد المراجعة عند شخص معين
  RETURNED   // مرجع للمرسل مع ملاحظات
  APPROVED   // معتمد نهائياً
  REJECTED   // مرفوض
  DELEGATED  // محوّل للتنفيذ
}

enum RequestPriority {
  LOW      // منخفضة
  MEDIUM   // متوسطة
  HIGH     // عالية
  URGENT   // عاجل
}

enum RequestAction {
  SUBMITTED      // رفع الطلب لأول مرة
  FORWARDED      // تمرير للمستوى التالي
  APPROVED_FINAL // اعتماد نهائي
  REJECTED       // رفض
  RETURNED       // إرجاع للمرسل
  DELEGATED      // تحويل التنفيذ لشخص آخر
  RESUBMITTED    // إعادة إرسال بعد الإرجاع
}

// سلسلة اعتماد — تُعرَّف من إعدادات الداشبورد
model WorkflowChain {
  id        String         @id @default(uuid())
  name      String
  isActive  Boolean        @default(false)
  steps     WorkflowStep[]
  requests  Request[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// مستوى واحد في السلسلة — يرتبط بشخص محدد
model WorkflowStep {
  id         String        @id @default(uuid())
  chainId    String
  chain      WorkflowChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  order      Int
  approverId String
  approver   Employee      @relation("WorkflowStepApprover", fields: [approverId], references: [id], onDelete: Cascade)
  label      String?

  @@unique([chainId, order])
  @@index([chainId])
}

// سجل كل خطوة مر بها الطلب
model RequestLog {
  id            String        @id @default(uuid())
  requestId     String
  request       Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder     Int           @default(0)
  actorId       String
  actor         Employee      @relation("LogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action        RequestAction
  note          String?       @db.Text
  delegatedToId String?
  delegatedTo   Employee?     @relation("LogDelegatee", fields: [delegatedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([requestId])
}

model Request {
  id                String          @id @default(uuid())
  title             String
  category          String?         // التصنيف: "زاد"، "الحوكمة"، إلخ
  body              String?         @db.Text
  fileUrl           String?
  attachments       Json?           // مصفوفة من المرفقات { url, name, size, publicId }
  priority          RequestPriority @default(MEDIUM)
  status            RequestStatus   @default(PENDING)
  // المُرسِل
  createdById       String
  createdBy         Employee        @relation("CreatedRequests", fields: [createdById], references: [id], onDelete: Cascade)
  // Workflow — السلسلة الحالية والمستوى
  chainId           String?
  chain             WorkflowChain?  @relation(fields: [chainId], references: [id], onDelete: SetNull)
  currentStepOrder  Int             @default(1)
  currentReviewerId String?
  currentReviewer   Employee?       @relation("CurrentReviewer", fields: [currentReviewerId], references: [id], onDelete: SetNull)
  // تحويل التنفيذ
  delegatedToId     String?
  delegatedTo       Employee?       @relation("DelegatedTo", fields: [delegatedToId], references: [id], onDelete: SetNull)
  // للتوافق مع الكود القديم
  reviewedById      String?
  reviewedBy        Employee?       @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?         @db.Text
  reviewedAt        DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  notifications     RequestNotification[]
  logs              RequestLog[]

  @@index([createdById])
  @@index([status])
  @@index([currentReviewerId])
}

model RequestNotification {
  id         String   @id @default(uuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("RequestNotifications", fields: [employeeId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([requestId, employeeId])
  @@index([employeeId, isRead])
}

model ContractInstallment {
  id                   String   @id @default(uuid())
  amount               Float
  dueDate              DateTime?
  isLinkedToFirstGrant Boolean  @default(false)
  isPaid               Boolean  @default(false)
  paidDate             DateTime?
  charityId            String
  charity              Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([charityId])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}
