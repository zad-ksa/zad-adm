generator client {
  provider = "prisma-client-js"

  /// relationJoins: يجعل findMany مع include استعلاماً واحداً بـ LATERAL JOIN
  /// بدل استعلام منفصل لكل علاقة.
  ///
  /// قياس فعلي على صفحة الاعتمادات: الاستدعاء الواحد كان يتحوّل إلى 9 رحلات
  /// إلى القاعدة. زمن SQL نفسه 0.17 مللي، لكن القاعدة في سيدني فالرحلة الواحدة
  /// تكلّف مئات المللي — والتسع تُضرب في ذلك. بعد التفعيل: رحلة واحدة،
  /// والوسيط نزل من 1564 مللي إلى 319.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
}

enum CharitySize {
  MICRO // متناهية الصغر
  SMALL // صغيرة
  MEDIUM // متوسطة
  LARGE // كبيرة
  MEGA // متناهية الكبر
}

model Charity {
  id                String    @id @default(uuid())
  name              String    @unique
  establishmentDate String?
  licenseNumber     String?
  logoUrl           String?
  domain            String?
  createdAt         DateTime  @default(now())
  programs          Program[]

  // Financial fields
  contractValue        Float                 @default(0)
  paidAmount           Float                 @default(0)
  grants               Float                 @default(0)
  financialLogs        FinancialLog[]
  contractInstallments ContractInstallment[]
  meetings             Meeting[]

  // Timeline Configurations
  strategyTimelineName String? @default("التخطيط الاستراتيجي")
  strategyTimelineDept String? @default("STRATEGY")

  governanceTimelineName String? @default("الحوكمة")
  governanceTimelineDept String? @default("GOVERNANCE")

  financeTimelineName String? @default("تنمية الموارد المالية")
  financeTimelineDept String? @default("FINANCE")

  // Core pillars manual contact info
  strategyResponsibleName    String?
  strategyResponsiblePhone   String?
  governanceResponsibleName  String?
  governanceResponsiblePhone String?
  financeResponsibleName     String?
  financeResponsiblePhone    String?

  // Contact Info
  email         String?
  phone         String?
  chairmanName  String?
  chairmanPhone String?
  ceoName       String?
  ceoPhone      String?

  regulationVisibilities CharityRegulationVisibility[]
  employees              Employee[]
  assignedEmployees      EmployeeCharity[]             @relation("AssignedEmployees")
  isReadinessVisible     Boolean                       @default(false)
  isVisionMissionVisible Boolean                       @default(false)
  isPerformanceEditable  Boolean                       @default(false)
  size                   CharitySize?
  annualRevenue          Float?
  services               Service[]
  visionMissionResponses VisionMissionResponse[]
  governanceProgress     GovernanceProgress[]
  donorAccounts          DonorAccount[]
  grantApplications      GrantApplication[]
  charityUsers           CharityUserCharity[]
  designRequests         DesignRequest[]

  // Attendance
  workSites         CharityWorkSite[]
  workSchedule      CharityWorkSchedule?
  attendanceRecords AttendanceRecord[]
  holidays          CharityHoliday[]
  employeeLeaves    EmployeeLeave[]

  // Optional second factor for attendance: the public IPs / CIDR ranges of the
  // charity's own network. Empty list = layer off. Browser GPS is trivially
  // spoofable from DevTools; network origin is not, so this is the stronger of
  // the two signals. See IpEnforcementMode for what a mismatch does.
  allowedIpRanges String[]          @default([])
  ipEnforcement   IpEnforcementMode @default(OFF)
}

// ── حسابات وبوابة الجمعيات ──────────────────────────────────────────────────────────

enum CharityUserTitle {
  CHAIRMAN // رئيس مجلس إدارة
  CEO // مدير تنفيذي
  FULL_TIME // موظف بدوام كامل
  PART_TIME // موظف بداوم جزئي
  VOLUNTEER // متطوع
  SYSTEM_ADMIN // مدير النظام
}

model CharityUser {
  id          String           @id @default(uuid())
  name        String
  phone       String           @unique
  /// Login email and bcrypt hash — both optional, both meaningless alone.
  /// See the note on Employee.email.
  email       String?          @unique
  password    String?
  title       CharityUserTitle @default(FULL_TIME)
  permissions String[]         @default([])
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  charities         CharityUserCharity[]
  designRequests    DesignRequest[]      @relation("SubmittedDesignRequests")
  attendanceRecords AttendanceRecord[]
  leaves            EmployeeLeave[]
}

model CharityUserCharity {
  id            String      @id @default(uuid())
  charityUserId String
  charityId     String
  user          CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charity       Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  // Permissions are scoped PER CHARITY, not per user. CharityUser.permissions
  // (left on the model, now unused) could not express "HR manager in charity A,
  // ordinary staff in charity B" — one array travelled with the account into
  // every charity it was linked to, which is a privilege leak.
  permissions String[] @default([])

  // Membership is deactivated PER CHARITY, never by deleting the row and never
  // via the account-wide CharityUser.isActive: an account may serve several
  // charities, so charity A removing someone must not lock them out of charity
  // B. Keeping the row (rather than deleting it) preserves who they were and
  // what they held, alongside their attendance history.
  isActive Boolean @default(true)

  // Administrator OF THIS CHARITY — the blanket "may do anything here" flag.
  //
  // This lives on the link for the same reason `permissions` does. It used to be
  // read from CharityUser.title == "SYSTEM_ADMIN", which is stored per ACCOUNT:
  // an account serving two charities was therefore an administrator of both at
  // once, and either charity could grant or revoke that standing for the other
  // — charity B promoting a shared member handed them full authority over
  // charity A, and demoting them stripped charity A of its administrator.
  //
  // The title stays on the account as a job label (CEO, chairman, volunteer …)
  // and now carries no authority of its own.
  isAdmin Boolean @default(false)

  /// تجاوز رصيد الإجازة السنوية لهذا الموظف في هذه الجمعية. `null` يعني اتّباع
  /// رصيد الجمعية الافتراضي. على الرابط لا على الحساب، فلكل جمعية رصيدها.
  annualLeaveDays Int?

  @@unique([charityUserId, charityId])
  @@index([charityUserId])
  @@index([charityId])
}

model EmployeeNavSetting {
  id         String   @id @default(uuid())
  employeeId String   @unique
  settings   Json
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model GovernanceProgress {
  id            String   @id @default(uuid())
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  indicatorId   String // The ID of the indicator from the static JSON
  status        String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  proofUrl      String?
  proofPublicId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([charityId, indicatorId])
  @@index([charityId])
}

model Meeting {
  id               String        @id @default(uuid())
  title            String
  date             DateTime
  meetingNumber    Int?
  location         String?
  charityId        String?
  charity          Charity?      @relation(fields: [charityId], references: [id], onDelete: SetNull)
  meetingContext   String?
  rawNotes         String        @db.Text
  formattedContent String        @db.Text
  summary          String?       @db.Text
  attendees        String?
  isPrivate        Boolean       @default(false)
  createdById      String
  createdBy        Employee      @relation("MeetingCreator", fields: [createdById], references: [id])
  meetingTasks     MeetingTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([createdById])
  @@index([charityId])
}

model MeetingTask {
  id           String    @id @default(uuid())
  meetingId    String
  meeting      Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title        String
  assignedToId String?
  assignedTo   Employee? @relation("MeetingTaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  dueDays      Int?
  dueDate      DateTime?
  isDone       Boolean   @default(false)
  createdAt    DateTime  @default(now())

  task Task?

  @@index([meetingId])
}

model FinancialLog {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  type      String // "CONTRACT_UPDATE" | "PAID_UPDATE" | "ADD_GRANT" | "DISBURSEMENT"
  amount    Float
  notes     String?
  createdAt DateTime @default(now())
}

model DonorAccount {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  donorName String
  username  String
  password  String
  website   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([charityId])
}

model GrantApplication {
  id                 String    @id @default(uuid())
  charityId          String
  charity            Charity   @relation(fields: [charityId], references: [id], onDelete: Cascade)
  entityName         String    @default("غير محدد")
  initiativeName     String
  requestedAmount    Float
  status             String    @default("PENDING") // "PENDING", "APPROVED", "REJECTED", "CLOSED"
  installmentsCount  Int?
  installmentsNotes  String?
  beneficiariesCount Int?
  collectedAmount    Float?
  closureDate        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([charityId])
}

model Program {
  id            String   @id @default(uuid())
  name          String
  beneficiaries Int
  charityId     String
  charity       Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SurveyResponse {
  id                String   @id @default(uuid())
  charityName       String
  establishmentDate String
  licenseNumber     String
  authorizedName    String
  authorizedTitle   String
  scorePercentage   Int
  answers           Json
  createdAt         DateTime @default(now())
}

model HexagonalResponse {
  id              String   @id @default(uuid())
  charityName     String
  authorizedTitle String
  answers         Json
  createdAt       DateTime @default(now())
}

model PerformanceMetric {
  id          String   @id @default(uuid())
  charityName String
  year        Int
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([charityName, year])
}

model RoleDefinition {
  id          String   @id @default(uuid())
  key         String   @unique
  displayName String
  permissions String[] @default([])
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Employee {
  id                      String                @id @default(uuid())
  name                    String
  phone                   String                @unique
  /// Login email. Optional on purpose: an account without one still signs in
  /// with phone + OTP exactly as before, so no migration can lock anyone out.
  email                   String?               @unique
  /// bcrypt hash. null means this person has not set up email login yet.
  password                String?
  avatarUrl               String?
  role                    String                @default("STRATEGY")
  charityId               String? // For CHARITY_CLIENT accounts
  charity                 Charity?              @relation(fields: [charityId], references: [id])
  permissions             String[]
  navOrder                String[]              @default([])
  isActive                Boolean               @default(true)
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt
  assignedTasks           Task[]                @relation("AssignedTasks")
  createdTasks            Task[]                @relation("CreatedTasks")
  assignedPermanentTasks  PermanentTask[]       @relation("AssignedPermanentTasks")
  createdPermanentTasks   PermanentTask[]       @relation("CreatedPermanentTasks")
  employeeAchievements    Achievement[]         @relation("EmployeeAchievements")
  createdAchievements     Achievement[]         @relation("CreatedAchievements")
  assignedCharities       EmployeeCharity[]     @relation("AssignedCharities")
  appNotifications        AppNotification[]
  createdMeetings         Meeting[]             @relation("MeetingCreator")
  meetingTasksAssigned    MeetingTask[]         @relation("MeetingTaskAssignee")
  navSetting              EmployeeNavSetting?
  createdRequests         Request[]             @relation("CreatedRequests")
  reviewedRequests        Request[]             @relation("ReviewedRequests")
  requestNotifications    RequestNotification[] @relation("RequestNotifications")
  workflowSteps           WorkflowStep[]        @relation("WorkflowStepApprover")
  requestLogs             RequestLog[]          @relation("LogActor")
  delegatedLogs           RequestLog[]          @relation("LogDelegatee")
  currentlyReviewing      Request[]             @relation("CurrentReviewer")
  delegatedRequests       Request[]             @relation("DelegatedTo")
  createdMeetingSchedules MeetingSchedule[]     @relation("CreatedMeetingSchedules")
  sentMails               InternalMail[]        @relation("SentMails")
  receivedMails           MailRecipient[]       @relation("ReceivedMails")
  createdDesignRequests   DesignRequest[]       @relation("CreatedDesignRequests")
  completedDesignRequests DesignRequest[]       @relation("CompletedDesignRequests")
  reviewedDesignRequests  DesignRequest[]       @relation("ReviewedDesignRequests")
  knowledgeNodes          KnowledgeNode[]       @relation("KnowledgeNodes")
}

model EmployeeCharity {
  id         String   @id @default(uuid())
  employeeId String
  charityId  String
  employee   Employee @relation("AssignedCharities", fields: [employeeId], references: [id], onDelete: Cascade)
  charity    Charity  @relation("AssignedEmployees", fields: [charityId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())

  @@unique([employeeId, charityId])
  @@index([employeeId])
  @@index([charityId])
}

model Task {
  id                 String       @id @default(uuid())
  title              String
  assignedToId       String
  assignedTo         Employee     @relation("AssignedTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById        String
  createdBy          Employee     @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Cascade)
  charityId          String?
  charityName        String?
  isInternal         Boolean      @default(false)
  isCompleted        Boolean      @default(false)
  status             String       @default("NOT_STARTED") // "NOT_STARTED", "IN_PROGRESS", "COMPLETED"
  priority           Int          @default(3) // 1: High, 2: Medium, 3: Low
  completedAt        DateTime?
  /// Proof of COMPLETION, attached when the task is closed.
  proofUrl           String?
  proofPublicId      String?
  completionNote     String?      @db.Text
  /// An image attached when the task is CREATED — the brief, not the proof.
  /// Deliberately separate from proofUrl: one describes what to do, the
  /// other shows it was done, and overwriting the first with the second
  /// would erase the instructions at the moment they stop being needed.
  attachmentUrl      String?
  attachmentPublicId String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  updates            TaskUpdate[]

  meetingTaskId String?      @unique
  meetingTask   MeetingTask? @relation(fields: [meetingTaskId], references: [id], onDelete: Cascade)

  @@index([assignedToId, isCompleted])
}

model TaskUpdate {
  id        String   @id @default(uuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([taskId])
}

model Achievement {
  id            String   @id @default(uuid())
  title         String
  employeeId    String
  employee      Employee @relation("EmployeeAchievements", fields: [employeeId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     Employee @relation("CreatedAchievements", fields: [createdById], references: [id], onDelete: Cascade)
  charityId     String?
  charityName   String?
  isInternal    Boolean  @default(false)
  proofUrl      String?
  proofPublicId String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId])
}

model News {
  id          String   @id @default(uuid())
  charityName String
  category    String
  title       String
  description String?
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([charityName])
}

model SurveyLink {
  id              String   @id @default(uuid())
  charityName     String
  surveyType      String // "READINESS" or "HEXAGONAL" or "VISION_MISSION"
  isActive        Boolean  @default(true)
  customQuestions Json?
  createdAt       DateTime @default(now())
}

model Regulation {
  id                  String                        @id @default(uuid())
  title               String
  description         String?
  category            String // "الإشراف والحوكمة" or "التحول الرقمي" or "القطاع غير الربحي"
  link                String
  createdAt           DateTime                      @default(now())
  updatedAt           DateTime                      @updatedAt
  charityVisibilities CharityRegulationVisibility[]
}

model CharityRegulationVisibility {
  id           String     @id @default(uuid())
  charityId    String
  regulationId String
  isVisible    Boolean    @default(true)
  charity      Charity    @relation(fields: [charityId], references: [id], onDelete: Cascade)
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([charityId, regulationId])
}

model ServiceTemplate {
  id         String                 @id @default(uuid())
  name       String
  department String?
  stages     ServiceStageTemplate[]
  services   Service[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceStageTemplate {
  id          String  @id @default(uuid())
  name        String
  description String?
  duration    String?
  order       Int     @default(0)

  templateId String
  template   ServiceTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id           String  @id @default(uuid())
  name         String
  department   String?
  charityId    String
  charity      Charity @relation(fields: [charityId], references: [id], onDelete: Cascade)
  isComingSoon Boolean @default(false)

  templateId String?
  template   ServiceTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  stages ServiceStage[]

  responsibleName  String?
  responsiblePhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceStage {
  id           String    @id @default(uuid())
  name         String
  description  String?
  startDate    DateTime?
  endDate      DateTime?
  duration     String?
  order        Int       @default(0)
  isCurrent    Boolean   @default(false)
  isContinuous Boolean   @default(false)
  isActive     Boolean   @default(true)
  isDone       Boolean   @default(false)
  isComingSoon Boolean   @default(false)

  templateId String?

  serviceId String
  service   Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  steps     ServiceStageStep[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model ServiceStageStep {
  id        String       @id @default(uuid())
  name      String
  isDone    Boolean      @default(false)
  startDate DateTime?
  endDate   DateTime?
  order     Int          @default(0)
  stageId   String
  stage     ServiceStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
}

model CustomSurvey {
  id        String                 @id @default(uuid())
  slug      String?                @unique
  title     String
  introText String?
  isActive  Boolean                @default(false)
  sections  CustomSurveySection[]
  responses CustomSurveyResponse[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt
}

model CustomSurveySection {
  id        String                 @id @default(uuid())
  title     String
  order     Int
  surveyId  String
  survey    CustomSurvey           @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  questions CustomSurveyQuestion[]
}

model CustomSurveyQuestion {
  id                     String              @id @default(uuid())
  text                   String
  type                   String              @default("TEXT") // "TEXT", "MULTIPLE_CHOICE", "FILE"
  isRequired             Boolean             @default(true)
  allowAttachment        Boolean             @default(false)
  requireAttachmentIfYes Boolean             @default(false)
  options                Json? // Array of { id, text, score } — for YES_NO questions this instead stores { followUpQuestions: [...] }
  order                  Int
  sectionId              String
  section                CustomSurveySection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
}

model CustomSurveyResponse {
  id          String       @id @default(uuid())
  surveyId    String
  survey      CustomSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  charityName String // Charity name or other info collected
  answers     Json // Stores {"questionId": "answer or optionId"}
  attachments Json? // Stores {"questionId": "fileUrl"}
  createdAt   DateTime     @default(now())
}

model VisionMissionResponse {
  id              String   @id @default(uuid())
  charityId       String
  charity         Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  charityName     String
  respondentName  String
  respondentTitle String
  answers         Json
  createdAt       DateTime @default(now())
}

model AchievementCategory {
  id        String   @id @default(uuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

// Default stages template — used when creating a new charity or resetting stages
model DefaultStage {
  id           String   @id @default(uuid())
  timelineType String // 'STRATEGY' | 'GOVERNANCE' | 'FINANCE'
  name         String
  description  String?
  order        Int      @default(0)
  isContinuous Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([timelineType])
}

// Global timeline display names (shown in tabs and headers across the app)
model TimelineConfig {
  id           String   @id @default(uuid())
  timelineType String   @unique // 'STRATEGY' | 'GOVERNANCE' | 'FINANCE'
  displayName  String
  updatedAt    DateTime @updatedAt
}

// ── نظام الطلبات ──────────────────────────────────────────────────────────────

enum RequestStatus {
  PENDING // قيد المراجعة عند شخص معين
  RETURNED // مرجع للمرسل مع ملاحظات
  APPROVED // معتمد نهائياً
  REJECTED // مرفوض
  DELEGATED // محوّل للتنفيذ
}

enum RequestPriority {
  LOW // منخفضة
  MEDIUM // متوسطة
  HIGH // عالية
  URGENT // عاجل
}

enum RequestAction {
  SUBMITTED // رفع الطلب لأول مرة
  FORWARDED // تمرير للمستوى التالي
  APPROVED_FINAL // اعتماد نهائي
  REJECTED // رفض
  RETURNED // إرجاع للمرسل
  DELEGATED // تحويل التنفيذ لشخص آخر
  RESUBMITTED // إعادة إرسال بعد الإرجاع
  // ملحقة في الآخر: إضافة قيمة لتعداد Postgres رخيصة، وإعادة الترتيب تستلزم
  // إعادة بناء النوع على بيانات حيّة.
  FORWARDED_DOWN // تمرير للمستوى الأدنى في السلسلة
}

// سلسلة اعتماد — تُعرَّف من إعدادات الداشبورد
model WorkflowChain {
  id        String         @id @default(uuid())
  name      String
  isActive  Boolean        @default(false)
  steps     WorkflowStep[]
  requests  Request[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

// مستوى واحد في السلسلة — يرتبط بشخص محدد
model WorkflowStep {
  id         String        @id @default(uuid())
  chainId    String
  chain      WorkflowChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  order      Int
  approverId String
  approver   Employee      @relation("WorkflowStepApprover", fields: [approverId], references: [id], onDelete: Cascade)
  label      String?

  @@unique([chainId, order])
  @@index([chainId])
}

// سجل كل خطوة مر بها الطلب
model RequestLog {
  id            String        @id @default(uuid())
  requestId     String
  request       Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder     Int           @default(0)
  actorId       String
  actor         Employee      @relation("LogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action        RequestAction
  note          String?       @db.Text
  delegatedToId String?
  delegatedTo   Employee?     @relation("LogDelegatee", fields: [delegatedToId], references: [id], onDelete: SetNull)
  createdAt     DateTime      @default(now())

  @@index([requestId])
  /// يخدم مسار «اعتمدتها»: البحث عن الطلبات التي اتخذ فيها موظف بعينه قراراً.
  @@index([actorId, action])
}

model Request {
  id                String                @id @default(uuid())
  title             String
  category          String? // التصنيف: "زاد"، "الحوكمة"، إلخ
  body              String?               @db.Text
  fileUrl           String?
  attachments       Json? // مصفوفة من المرفقات { url, name, size, publicId }
  priority          RequestPriority       @default(MEDIUM)
  status            RequestStatus         @default(PENDING)
  // المُرسِل
  createdById       String
  createdBy         Employee              @relation("CreatedRequests", fields: [createdById], references: [id], onDelete: Cascade)
  // Workflow — السلسلة الحالية والمستوى
  chainId           String?
  chain             WorkflowChain?        @relation(fields: [chainId], references: [id], onDelete: SetNull)
  currentStepOrder  Int                   @default(1)
  currentReviewerId String?
  currentReviewer   Employee?             @relation("CurrentReviewer", fields: [currentReviewerId], references: [id], onDelete: SetNull)
  // تحويل التنفيذ
  delegatedToId     String?
  delegatedTo       Employee?             @relation("DelegatedTo", fields: [delegatedToId], references: [id], onDelete: SetNull)
  // للتوافق مع الكود القديم
  reviewedById      String?
  reviewedBy        Employee?             @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?               @db.Text
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  notifications     RequestNotification[]
  logs              RequestLog[]

  @@index([createdById])
  @@index([status])
  @@index([currentReviewerId])
  /// يخدم شرط الرؤية { status: DELEGATED, delegatedToId } — كان مسحاً كاملاً
  /// للجدول في كل تحميل وكل استطلاع.
  @@index([delegatedToId])
}

model RequestNotification {
  id         String   @id @default(uuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("RequestNotifications", fields: [employeeId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([requestId, employeeId])
  @@index([employeeId, isRead])
}

model ContractInstallment {
  id                   String    @id @default(uuid())
  amount               Float
  dueDate              DateTime?
  isLinkedToFirstGrant Boolean   @default(false)
  isPaid               Boolean   @default(false)
  paidDate             DateTime?
  charityId            String
  charity              Charity   @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([charityId])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PermanentTask {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  recurrenceRate String
  assignedToId   String
  assignedTo     Employee @relation("AssignedPermanentTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Employee @relation("CreatedPermanentTasks", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([assignedToId])
}

model AppNotification {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  message    String?  @db.Text
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
}

model MeetingSchedule {
  id            String           @id @default(uuid())
  title         String
  slug          String           @unique
  duration      Int              @default(30)
  availableDays Json // array of { date, startTime, endTime }
  isActive      Boolean          @default(true)
  createdById   String
  createdBy     Employee         @relation("CreatedMeetingSchedules", fields: [createdById], references: [id], onDelete: Cascade)
  bookings      MeetingBooking[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([createdById])
}

model MeetingBooking {
  id          String          @id @default(uuid())
  scheduleId  String
  schedule    MeetingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  charityName String
  date        String
  startTime   String
  createdAt   DateTime        @default(now())

  @@unique([scheduleId, date, startTime])
  @@index([scheduleId])
}

model InternalMail {
  id       String   @id @default(uuid())
  subject  String
  body     String   @db.Text
  senderId String
  sender   Employee @relation("SentMails", fields: [senderId], references: [id], onDelete: Cascade)

  // للربط بسلسلة الردود
  parentId String? // الرسالة الأصلية (في حال الرد)
  parent   InternalMail?  @relation("MailThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  InternalMail[] @relation("MailThread")

  // حالة المرسل
  isDeletedBySender Boolean @default(false) // حذف من "المرسل"

  // المسودات — تُحفظ قبل الإرسال الفعلي ولا تملك MailRecipient بعد
  isDraft     Boolean  @default(false)
  draftToIds  String[] @default([])
  draftCcIds  String[] @default([])
  draftBccIds String[] @default([])

  recipients  MailRecipient[]
  attachments MailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([senderId])
  @@index([senderId, isDraft])
  @@index([parentId])
}

model MailRecipient {
  id         String       @id @default(uuid())
  mailId     String
  mail       InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee     @relation("ReceivedMails", fields: [employeeId], references: [id], onDelete: Cascade)

  type      String  @default("TO") // "TO" | "CC" | "BCC"
  isRead    Boolean @default(false)
  isStarred Boolean @default(false)
  isDeleted Boolean @default(false) // سلة المهملات

  @@unique([mailId, employeeId])
  @@index([employeeId, isDeleted, isRead])
  @@index([mailId])
}

model MailAttachment {
  id       String       @id @default(uuid())
  mailId   String
  mail     InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  fileUrl  String
  fileName String
  fileSize Int?

  @@index([mailId])
}

enum KnowledgeNodeKind {
  FOLDER
  FILE
}

/// عقدة في «شجرة المعرف»: مجلد أو ملف.
///
/// شجرة واحدة عامة لموظفي زاد، غير تابعة لجمعية — الجذر هو الصفوف التي
/// `parentId` فيها null، والتعشيش بلا حدّ تمامًا كمتصفح الملفات.
///
/// النسخة السابقة من هذه الفكرة كانت تحفظ في `localStorage`، فكانت المجلدات
/// موجودة في متصفح من أنشأها وحده ولا يراها زملاؤه. الجدول هنا هو الفرق
/// الجوهري بين الفكرتين، لا الواجهة.
model KnowledgeNode {
  id   String            @id @default(uuid())
  name String
  kind KnowledgeNodeKind

  /// null للعقد في الجذر. الحذف متتالٍ: حذف مجلد يحذف ذريته كلها في
  /// قاعدة البيانات، ويبقى على الإجراء أن يزيل ملفاتها من Cloudinary قبل ذلك.
  parentId String?
  parent   KnowledgeNode?  @relation("KnowledgeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgeNode[] @relation("KnowledgeTree")

  // ── حقول الملفات وحدها؛ كلها null للمجلد ──────────────────────────────
  fileUrl      String?
  /// يلزم لحذف الأصل من Cloudinary لاحقًا.
  publicId     String?
  /// Cloudinary يحتاج النوع نفسه عند الحذف، وإلا افترض "image" ولم يحذف شيئًا.
  resourceType String?
  fileSize     Int?

  createdById String?
  createdBy   Employee? @relation("KnowledgeNodes", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

// ── طلبات التصاميم ───────────────────────────────────────────────────────────

enum DesignRequestStatus {
  PENDING // قيد التنفيذ / في الطابور
  COMPLETED // منجز
  // ملحقتان في الآخر عمداً: إضافة قيمة لنوع تعداد في Postgres عملية رخيصة،
  // أما إعادة ترتيب القيم فتستلزم إعادة بناء النوع على بيانات حيّة.
  UNDER_REVIEW // قيد المراجعة — رفعته الجمعية وينتظر اعتماد موظف زاد
  REJECTED // مرفوض مع سبب مكتوب
  AWAITING_REVIEW // سُلّم وبانتظار ردّ الجمعية خلال 24 ساعة
  REVISION_REQUESTED // أعادته الجمعية بملاحظات، وزاد تعدّل خلال 24 ساعة
}

/// نوع التصميم وعدد أيام العمل الخاصة به — يديره موظف زاد من صفحة طلبات التصاميم.
///
/// تعديل `workingDays` لاحقاً لا يمسّ الطلبات القائمة إطلاقاً: مواعيدها محسوبة
/// ومجمّدة عند الإنشاء (انظر DesignRequest أدناه)، وعدد الأيام المستعمل وقتها
/// محفوظ في `baseWorkingDays`. النوع الجديد يسري على الطلبات الجديدة وحدها.
model DesignType {
  id          String  @id @default(uuid())
  name        String  @unique
  workingDays Int
  /// يُعطَّل ولا يُحذف: الطلبات السابقة تشير إليه، وسجلّها يجب أن يظل قادراً على
  /// قول أي نوع كانت.
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  requests DesignRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model DesignRequest {
  id          String              @id @default(uuid())
  /// null تعني أن الطلب لشركة زاد نفسها لا لجمعية.
  ///
  /// اخترنا الغياب على سجل جمعية وهمي باسم «شركة زاد»، لأن السجل الوهمي يظهر
  /// في كل قائمة جمعيات في الموقع — الحوكمة والاستراتيجية والعقود والموارد
  /// البشرية — ويحتاج استثناءً في كل واحدة منها.
  charityId   String?
  charity     Charity?            @relation(fields: [charityId], references: [id], onDelete: Cascade)
  title       String
  description String?             @db.Text
  status      DesignRequestStatus @default(PENDING)

  /// أنواع التصميم المختارة. يجوز اختيار أكثر من نوع، ومجموع أيامها هو
  /// `baseWorkingDays`.
  types DesignType[]

  /// عدد أيام العمل المستعمل فعلاً عند حساب الموعد، مثبَّتاً وقت الإنشاء.
  /// وجوده يجعل الموعد قابلاً للتفسير بعد شهور، ويحمي الطلب من تعديل لاحق على
  /// أيام النوع.
  baseWorkingDays Int @default(3)
  /// أيام أضافها موظف زاد بعد الرفع. تُزاد على المدة ولا تمسّ تاريخ البدء —
  /// فصلها عن `baseWorkingDays` هو ما يُبقي الأصل والتمديد مقروءين معاً.
  addedDays       Int @default(0)

  // جدولة الطابور — تُحسب مرة واحدة عند الإنشاء ولا يُعاد حسابها أبداً بعد ذلك،
  // حتى لو أُنجز طلب سابق قبل موعده. لا تُضف منطق إعادة جدولة هنا.
  submittedAt            DateTime @default(now())
  scheduledStartDate     DateTime
  expectedCompletionDate DateTime

  completedAt   DateTime?
  completedById String?
  completedBy   Employee? @relation("CompletedDesignRequests", fields: [completedById], references: [id], onDelete: SetNull)

  // ── المراجعة قبل دخول الطابور ──────────────────────────────────────────
  // طلب الجمعية يبدأ UNDER_REVIEW ولا يحجز مكاناً في الطابور، لأن
  // computeSchedule لا يحسب إلا صفوف PENDING. عند الاعتماد يُعاد حساب الموعد
  // على الطابور كما هو لحظتَها لا كما كان وقت الرفع — وهذا هو معنى «تأكيد
  // الموعد»: ما رأته الجمعية عند الرفع تقدير، وما بعد الاعتماد التزام.
  // ── مراجعة الجمعية بعد التسليم ─────────────────────────────────────────
  // «إنهاء» لم يعد نهائياً: الطلب يذهب للجمعية 24 ساعة والمرفقات تبقى. الحذف
  // من Cloudinary لا يقع إلا عند الاعتماد النهائي — يدوياً أو تلقائياً أو بعد
  // جولة التعديل الوحيدة.
  //
  // الحالتان AWAITING_REVIEW و REVISION_REQUESTED خارج ترتيب التنفيذ بحكم
  // البناء: computeSchedule لا يحسب إلا صفوف PENDING.

  /// متى سُلّم — منه تُحسب مهلة الـ24 ساعة الممنوحة للجمعية.
  deliveredAt         DateTime?
  /// متى أعادته الجمعية — منه تُحسب مهلة التعديل.
  revisionRequestedAt DateTime?
  /// ملاحظات الجمعية. حقل واحد لا جدول، لأن التعديل مسموح مرة واحدة فقط
  /// فلا تاريخ جولات يُحفظ.
  revisionNotes       String?   @db.Text
  /// اعتُمد بمرور المهلة لا بفعل الجمعية — يُعرض للطرفين.
  autoApproved        Boolean   @default(false)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Employee? @relation("ReviewedDesignRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// سبب الرفض كما كتبه الموظف. تراه الجمعية في تبويب «المرفوضة».
  rejectionReason String?   @db.Text

  // مصدر الطلب: أحد الحقلين فقط يكون مُعبّأً
  charityUserId       String?
  charityUser         CharityUser? @relation("SubmittedDesignRequests", fields: [charityUserId], references: [id], onDelete: SetNull)
  createdByEmployeeId String?
  createdByEmployee   Employee?    @relation("CreatedDesignRequests", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  attachments DesignRequestAttachment[]
  extensions  DesignRequestExtension[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([charityId, status])
  @@index([status])
  @@index([scheduledStartDate])
}

/// سبب كل تمديد على حدة — لا حقل واحد يُكتب فوقه.
///
/// الجمعية ترى هذه القائمة في صفحة طلباتها، فهي تفسير موعد التسليم لا مجرد
/// أثر داخلي: الطلب الذي تأخّر مرتين له سببان، ودمجهما في نص واحد يخفي أن
/// التأخير حدث مرتين.
model DesignRequestExtension {
  id            String        @id @default(uuid())
  requestId     String
  request       DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// أيام العمل المضافة في هذه المرة تحديداً.
  days          Int
  reason        String        @db.Text
  /// موظف زاد الذي أضافها. تُترك بلا علاقة حتى يبقى السبب ظاهراً للجمعية حتى
  /// لو حُذف الحساب لاحقاً.
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())

  @@index([requestId, createdAt])
}

/// ما الذي يمثّله المرفق — وهو ما يقرّر مصيره عند إنهاء الطلب.
enum DesignAttachmentKind {
  /// ملفات الجمعية المرفقة مع الطلب. تُحذف من التخزين عند الإنهاء، لأنها مواد
  /// إدخال انتهى الغرض منها ولا داعي لإبقائها تستهلك مساحة.
  BRIEF
  /// الملف النهائي الذي يرفعه موظف زاد عند التسليم. يبقى — فهو ناتج العمل،
  /// والجمعية تحتاج تنزيله بعد الإنهاء لا قبله.
  DELIVERABLE
}

model DesignRequestAttachment {
  id           String               @id @default(uuid())
  requestId    String
  request      DesignRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         DesignAttachmentKind @default(BRIEF)
  fileUrl      String
  publicId     String
  resourceType String               @default("raw") // "raw" | "image" | "video" — مطلوب لنجاح حذف الملف من Cloudinary
  fileName     String
  fileSize     Int?
  createdAt    DateTime             @default(now())

  @@index([requestId])
  @@index([requestId, kind])
}

// ── سجل التدقيق (Audit Log) ─────────────────────────────────────────────────
// لا توجد أي عملية تعديل أو حذف مبنية على هذا الجدول عمداً — السجلات للقراءة
// فقط من داخل التطبيق، حماية لها من التلاعب.
enum AuditActorType {
  EMPLOYEE
  CHARITY_USER
  SYSTEM
}

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  actorName  String?
  action     String // "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGOUT" | "PERMISSION_CHANGE" | "DELETE" | "CREATE" | "FILE_UPLOAD"
  targetType String? // e.g. "Employee", "RoleDefinition", "DonorAccount"
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// الحضور والانصراف — Attendance
// ---------------------------------------------------------------------------

/// نوع إجازة الموظف. `ANNUAL` وحدها هي التي تُخصم من الرصيد السنوي — المرضية
/// وغيرها تمنع احتساب الغياب لكنها لا تستهلك رصيداً.
enum LeaveType {
  ANNUAL // سنوية
  SICK // مرضية
  UNPAID // بدون راتب
  OTHER // أخرى
}

/// إجازة تخصّ الجمعية كلها: عيد، يوم وطني، تعطيل استثنائي.
///
/// مدى لا يوم واحد، لأن العيد أيام لا يوم. اليوم المفرد يُخزَّن بـ start = end.
/// التواريخ مراسٍ منتصف ليل UTC ليوم الرياض المدني، كسائر تواريخ الحضور.
model CharityHoliday {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  /// اسم الإجازة كما يظهر في التقرير — «عيد الفطر»، «اليوم الوطني».
  name      String
  startDate DateTime
  endDate   DateTime

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([charityId, startDate])
}

/// إجازة موظف بعينه.
///
/// `charityId` جزء من السجل لا تفصيلاً: الموظف قد يخدم جمعيتين، وإجازته من
/// إحداهما لا تعني غيابه مبرَّراً في الأخرى.
model EmployeeLeave {
  id            String      @id @default(uuid())
  charityUserId String
  user          CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charityId     String
  charity       Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)

  type      LeaveType @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  note      String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([charityId, startDate])
  @@index([charityUserId, startDate])
}

enum AttendanceStatus {
  PRESENT // حاضر
  LATE // متأخر
  EARLY_LEAVE // انصراف مبكر
  ABSENT // غائب
}

/// How a mismatch against Charity.allowedIpRanges is handled.
/// OFF   — layer disabled (also the effective behaviour when the list is empty).
/// WARN  — check-in succeeds but is flagged isSuspicious for human review.
/// BLOCK — check-in is refused unless the request comes from the charity network.
enum IpEnforcementMode {
  OFF
  WARN
  BLOCK
}

/// A physical location employees may check in from.
model CharityWorkSite {
  id           String   @id @default(uuid())
  charityId    String
  charity      Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance AttendanceRecord[]

  @@index([charityId, isActive])
}

/// Working hours/days for a charity. One row per charity.
model CharityWorkSchedule {
  id                      String  @id @default(uuid())
  charityId               String  @unique
  charity                 Charity @relation(fields: [charityId], references: [id], onDelete: Cascade)
  startTime               String  @default("08:00") // Riyadh local, "HH:MM"
  endTime                 String  @default("16:00")
  lateAfterMinutes        Int     @default(15)
  earlyLeaveBeforeMinutes Int     @default(15)
  workDays                Int[]   @default([0, 1, 2, 3, 4]) // Sunday(0)..Thursday(4)

  /// متى فُتح التحضير في هذه الجمعية. `null` يعني مغلقاً — وهي الحالة الابتدائية.
  ///
  /// حقل واحد يؤدي دورين لأنهما في الحقيقة سؤال واحد:
  ///  1. البوابة — لا يُقبل تسجيل حضور ما لم يفتحه صاحب صلاحية manage_attendance،
  ///     فلا تبدأ جمعية بجمع بيانات موقع موظفيها لمجرد أن الميزة نُشرت.
  ///  2. بداية احتساب الغياب — الغياب مشتقّ لا مخزَّن، ويُحسب من هذا التاريخ فقط.
  ///     فالأيام التي سبقت الفتح لا تُحتسب غياباً على أحد، وهذا ما يمسح الغيابات
  ///     الوهمية المتراكمة قبل التفعيل.
  ///
  /// الإغلاق يُعيده إلى `null`، أي يمسح خط البداية أيضاً: إعادة الفتح تبدأ
  /// الاحتساب من جديد. مقصود — فترة الإغلاق ليست غياباً، ولا يصح أن تُحتسب.
  attendanceOpenedAt DateTime?

  /// رصيد الإجازة السنوية الافتراضي لكل موظف، بأيام العمل. يمكن تجاوزه لموظف
  /// بعينه من CharityUserCharity.annualLeaveDays.
  annualLeaveDays Int @default(21)

  updatedAt DateTime @updatedAt
}

/// One row per employee per charity per civil (Riyadh) day.
///
/// The charity is part of the key, not just a column: an account may serve
/// several charities, and each of them tracks that person's attendance
/// independently. Keying on (employee, day) alone made one charity's check-in
/// suppress every other charity's for the rest of the day.
///
/// The composite unique key is also what makes a duplicate check-in
/// structurally impossible, rather than relying on application logic that two
/// concurrent requests could race past.
model AttendanceRecord {
  id            String           @id @default(uuid())
  charityUserId String
  user          CharityUser      @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charityId     String
  charity       Charity          @relation(fields: [charityId], references: [id], onDelete: Cascade)
  workSiteId    String?
  workSite      CharityWorkSite? @relation(fields: [workSiteId], references: [id], onDelete: SetNull)

  /// UTC-midnight anchor of the Riyadh calendar day, computed on the SERVER.
  /// Never taken from the client clock — that would let a user back-date an
  /// attendance by changing their phone's date.
  workDate DateTime

  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  checkInDistance Float?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutDistance Float?

  status AttendanceStatus @default(PRESENT)

  // Review / forensics trail
  ipAddress        String?
  userAgent        String?
  isSuspicious     Boolean @default(false)
  suspiciousReason String?

  /// Set when a manager entered or amended this row by hand, which is the only
  /// way to record attendance the GPS could not confirm — a failed fix indoors
  /// must not cost an employee a day they actually worked.
  ///
  /// Non-null is the flag as well as the timestamp: every screen that shows a
  /// record must label it, because a hand-entered row carries no location
  /// evidence at all and must never be mistaken for a verified check-in. The
  /// coordinate columns stay null for exactly that reason.
  manualAt     DateTime?
  /// CharityUser who made the correction. Deliberately not a relation: the row
  /// should survive that account being deleted, and the full actor detail lives
  /// in the audit log.
  manualById   String?
  /// Required from the manager, and shown alongside the record.
  manualReason String?

  /// Set by the nightly job when a day ended with a check-in and no check-out.
  ///
  /// The job writes the schedule's end time into `checkOutAt` so the day stops
  /// hanging open, but that time is an assumption, not an observation — this
  /// column is what says so. Every screen showing the record must label it, and
  /// it is also the signal the HR alert counts, so a manager can see who keeps
  /// forgetting and correct the ones that matter.
  autoClosedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([charityUserId, charityId, workDate])
  @@index([charityId, workDate])
  // Serves both the nightly sweep (find open days) and the HR alert (count
  // auto-closed ones) without scanning the table.
  @@index([charityId, autoClosedAt])
  // Cross-charity, for the impossible-travel check, which deliberately looks at
  // the person's movements everywhere rather than only within one charity.
  @@index([charityUserId, workDate])
}
