  displayName  String
  updatedAt    DateTime @updatedAt
}

// ── نظام الطلبات ──────────────────────────────────────────────────────────────

enum RequestStatus {
  PENDING // قيد المراجعة عند شخص معين
  RETURNED // مرجع للمرسل مع ملاحظات
  APPROVED // معتمد نهائياً
  REJECTED // مرفوض
  DELEGATED // محوّل للتنفيذ
}

enum RequestPriority {
  LOW // منخفضة
  MEDIUM // متوسطة
  HIGH // عالية
  URGENT // عاجل
}

enum RequestAction {
  SUBMITTED // رفع الطلب لأول مرة
  FORWARDED // تمرير للمستوى التالي
  APPROVED_FINAL // اعتماد نهائي
  REJECTED // رفض
  RETURNED // إرجاع للمرسل
  DELEGATED // تحويل التنفيذ لشخص آخر
  RESUBMITTED // إعادة إرسال بعد الإرجاع
  // ملحقة في الآخر: إضافة قيمة لتعداد Postgres رخيصة، وإعادة الترتيب تستلزم
  // إعادة بناء النوع على بيانات حيّة.
  FORWARDED_DOWN // تمرير للمستوى الأدنى في السلسلة
}

// سلسلة اعتماد — تُعرَّف من إعدادات الداشبورد
model WorkflowChain {
  id        String         @id @default(uuid())
  name      String
  /// GENERAL | FINANCIAL — غرضُ السلسلة.
  ///
  /// وسلسلةٌ نشطةٌ واحدةٌ لكل غرض لا للموقع كلّه: setActiveChain كانت تُلغي
  /// تفعيل الكلّ ثم تُفعّل واحدة، فلم يكن للموقع إلا مسارٌ واحد.
  purpose   String         @default("GENERAL")
  isActive  Boolean        @default(false)
  steps     WorkflowStep[]
  requests  Request[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([purpose, isActive])
}

// مستوى واحد في السلسلة — يرتبط بشخص محدد
model WorkflowStep {
  id         String        @id @default(uuid())
  chainId    String
  chain      WorkflowChain @relation(fields: [chainId], references: [id], onDelete: Cascade)
  order      Int
  approverId String
  approver   Employee      @relation("WorkflowStepApprover", fields: [approverId], references: [id], onDelete: Cascade)
  label      String?

  @@unique([chainId, order])
  @@index([chainId])
}

// سجل كل خطوة مر بها الطلب
model RequestLog {
  id            String        @id @default(uuid())
  requestId     String
  request       Request       @relation(fields: [requestId], references: [id], onDelete: Cascade)
  stepOrder     Int           @default(0)
  actorId       String
  actor         Employee      @relation("LogActor", fields: [actorId], references: [id], onDelete: Cascade)
  action        RequestAction
  note          String?       @db.Text
  delegatedToId String?
  delegatedTo   Employee?     @relation("LogDelegatee", fields: [delegatedToId], references: [id], onDelete: SetNull)
  /// مرفقاتُ القرار نفسه، بشكل Request.attachments.
  ///
  /// والحاجة إليها من الطلب المالي: المعتمِد يُصدِّر النموذج على الكليشة
  /// ويختمه ويوقّعه ثم يرفعه مع اعتماده. فالوثيقة المختومة أثرُ قرارٍ بعينه
  /// لا أثرُ الطلب — ولو عُلّقت بالطلب لما عُرف صاحبُ الختم من معتمِديه.
  attachments   Json?
  createdAt     DateTime      @default(now())

  @@index([requestId])
  /// يخدم مسار «اعتمدتها»: البحث عن الطلبات التي اتخذ فيها موظف بعينه قراراً.
  @@index([actorId, action])
}

model Request {
  id                String                @id @default(uuid())
  title             String
  /// GENERAL | FINANCIAL — مُميِّزُ نوع الطلب لا تصنيفه.
  ///
  /// والمظروف مشترك: السلسلة والسجلّ والإشعار والتفويض تعمل للنوعين، فلا
  /// يُكتب محرّكُ اعتمادٍ ثانٍ يُصان مرّتين. والفصل في كل ما يُرى: صفحةٌ
  /// وصلاحيةٌ وسلسلةٌ وإعداداتٌ وتصديرٌ خاصّ بالمالي.
  ///
  /// وشرطُ النوع إلزاميٌّ في visibleRequestFilter، فنسيانُه خطأُ ترجمةٍ لا
  /// طلبٌ يظهر في غير مكانه.
  kind              String                @default("GENERAL")
  category          String? // التصنيف: "زاد"، "الحوكمة"، إلخ
  body              String?               @db.Text
  fileUrl           String?
  attachments       Json? // مصفوفة من المرفقات { url, name, size, publicId }
  priority          RequestPriority       @default(MEDIUM)
  status            RequestStatus         @default(PENDING)
  // المُرسِل
  createdById       String
  createdBy         Employee              @relation("CreatedRequests", fields: [createdById], references: [id], onDelete: Cascade)
  // Workflow — السلسلة الحالية والمستوى
  chainId           String?
  chain             WorkflowChain?        @relation(fields: [chainId], references: [id], onDelete: SetNull)
  currentStepOrder  Int                   @default(1)
  currentReviewerId String?
  currentReviewer   Employee?             @relation("CurrentReviewer", fields: [currentReviewerId], references: [id], onDelete: SetNull)
  // تحويل التنفيذ
  delegatedToId     String?
  delegatedTo       Employee?             @relation("DelegatedTo", fields: [delegatedToId], references: [id], onDelete: SetNull)
  // للتوافق مع الكود القديم
  reviewedById      String?
  reviewedBy        Employee?             @relation("ReviewedRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote        String?               @db.Text
  reviewedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  notifications     RequestNotification[]
  logs              RequestLog[]

  financial FinancialRequest?

  @@index([createdById])
  @@index([status])
  @@index([currentReviewerId])
  /// يخدم قائمتي الصفحتين: كلٌّ تطلب نوعها وحالته.
  @@index([kind, status])
  /// يخدم شرط الرؤية { status: DELEGATED, delegatedToId } — كان مسحاً كاملاً
  /// للجدول في كل تحميل وكل استطلاع.
  @@index([delegatedToId])
}

model RequestNotification {
  id         String   @id @default(uuid())
  requestId  String
  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation("RequestNotifications", fields: [employeeId], references: [id], onDelete: Cascade)
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([requestId, employeeId])
  @@index([employeeId, isRead])
}

model ContractInstallment {
  id                   String    @id @default(uuid())
  amount               Float
  dueDate              DateTime?
  isLinkedToFirstGrant Boolean   @default(false)
  isPaid               Boolean   @default(false)
  paidDate             DateTime?
  charityId            String
  charity              Charity   @relation(fields: [charityId], references: [id], onDelete: Cascade)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([charityId])
}

model GlobalSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model PermanentTask {
  id             String   @id @default(uuid())
  title          String
  description    String?  @db.Text
  recurrenceRate String
  assignedToId   String
  assignedTo     Employee @relation("AssignedPermanentTasks", fields: [assignedToId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      Employee @relation("CreatedPermanentTasks", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([assignedToId])
}

model AppNotification {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title      String
  message    String?  @db.Text
  link       String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([employeeId, isRead])
}

model MeetingSchedule {
  id                      String                      @id @default(uuid())
  title                   String
  slug                    String                      @unique
  duration                Int                         @default(30)
  availableDays           Json // array of { date, startTime, endTime }
  isActive                Boolean                     @default(true)
  // يظهر للجمعية على صفحة الحجز العامة خيار "لا يناسبني أي من هذه الأوقات"
  // فقط حين يفعّله منشئ الجدول لهذا الجدول تحديداً.
  allowAlternativeRequest Boolean                     @default(false)
  createdById             String
  createdBy               Employee                    @relation("CreatedMeetingSchedules", fields: [createdById], references: [id], onDelete: Cascade)
  bookings                MeetingBooking[]
  alternativeRequests     MeetingAlternativeRequest[]
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([createdById])
}

model MeetingBooking {
  id          String          @id @default(uuid())
  scheduleId  String
  schedule    MeetingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  charityName String
  date        String
  startTime   String
  createdAt   DateTime        @default(now())

  @@unique([scheduleId, date, startTime])
  @@index([scheduleId])
}

// طلب تواصل من جمعية تعذّرت عليها كل الأوقات المتاحة في الجدول — لا يحجز
// موعداً فعلياً، فهو منفصل عن MeetingBooking وبلا قيد تفرّد على الوقت
// (النص حرّ: تاريخ مقترح أو مجرد ملاحظة)، بانتظار متابعة يدوية من الموظف.
model MeetingAlternativeRequest {
  id           String          @id @default(uuid())
  scheduleId   String
  schedule     MeetingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  charityName  String
  message      String          @db.Text
  contactPhone String?
  createdAt    DateTime        @default(now())

  @@index([scheduleId])
}

model InternalMail {
  id       String    @id @default(uuid())
  subject  String
  body     String    @db.Text
  /// المرسِل موظف زاد. يصير فارغاً حين يكون المرسِل عضو جمعية.
  senderId String?
  sender   Employee? @relation("SentMails", fields: [senderId], references: [id], onDelete: Cascade)

  /// "EMPLOYEE" أو "CHARITY_USER" — أيّ الحقلين أعلاه هو المرسِل.
  senderKind String @default("EMPLOYEE")

  senderCharityUserId String?
  senderCharityUser   CharityUser? @relation("CharitySentMails", fields: [senderCharityUserId], references: [id], onDelete: Cascade)

  /// الخدمة التي أُرسل البريد باسمها (من زاد) أو إليها (من جمعية) — بالاسم لا
  /// بالمعرّف، كبقية منوحات الخدمات: الخدمة الواحدة صفٌّ في كل جمعية.
  serviceName String?

  /// الجمعية الطرف الآخر — للعرض والتصفية.
  charityId String?
  charity   Charity? @relation("CharityMails", fields: [charityId], references: [id], onDelete: SetNull)

  /// كيف عُنون البريد: "PERSON" أو "CHARITY" أو "SERVICE". منه تُبنى الترويسة
  /// الظاهرة للجمعية: «زاد | خدمة الإعلامية».
  addressedAs String @default("PERSON")

  /// التعميد: "NONE" بلا تعميد · "PENDING" بانتظار · "APPROVED" معتمد ·
  /// "RETURNED" أُرجع لصاحبه. والبريد المنتظر لا مستلمين له بعد.
  approvalState           String    @default("NONE")
  /// المعمِّد — موظف زاد أو عضو جمعية. بلا علاقةٍ مُصرَّحة: أثرٌ للتدقيق لا
  /// يُستعلم عنه من الجهة الأخرى.
  approvedById            String?
  approvedByCharityUserId String?
  approvedAt              DateTime?
  /// ملاحظة المعمِّد حين يُرجع البريد إلى مسودات صاحبه.
  returnNote              String?

  // للربط بسلسلة الردود
  parentId String? // الرسالة الأصلية (في حال الرد)
  parent   InternalMail?  @relation("MailThread", fields: [parentId], references: [id], onDelete: SetNull)
  replies  InternalMail[] @relation("MailThread")

  // حالة المرسل
  isDeletedBySender Boolean @default(false) // حذف من "المرسل"

  // المسودات — تُحفظ قبل الإرسال الفعلي ولا تملك MailRecipient بعد
  isDraft             Boolean  @default(false)
  draftToIds          String[] @default([])
  draftCcIds          String[] @default([])
  draftBccIds         String[] @default([])
  /// مستلمو المسودة من غير موظفي زاد: أعضاء جمعيات، أو جمعياتٌ بكاملها.
  draftCharityUserIds String[] @default([])
  draftCharityIds     String[] @default([])

  recipients  MailRecipient[]
  attachments MailAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([senderId])
  @@index([senderId, isDraft])
  @@index([parentId])
}

model MailRecipient {
  id         String       @id @default(uuid())
  mailId     String
  mail       InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  /// المستلم: أحد الحقلين مملوء والآخر فارغ.
  employeeId String?
  employee   Employee?    @relation("ReceivedMails", fields: [employeeId], references: [id], onDelete: Cascade)

  charityUserId String?
  charityUser   CharityUser? @relation("CharityReceivedMails", fields: [charityUserId], references: [id], onDelete: Cascade)
  /// جمعية المستلم حين يكون عضو جمعية — نطاق الصندوق.
  charityId     String?

  type      String  @default("TO") // "TO" | "CC" | "BCC"
  isRead    Boolean @default(false)
  isStarred Boolean @default(false)
  isDeleted Boolean @default(false) // سلة المهملات

  // القيدان يعملان معاً بلا تعارض: Postgres يعدّ كل NULL مميّزاً، فصفوف أعضاء
  // الجمعيات (employeeId فارغ) لا تصطدم بالقيد الأول، والعكس.
  @@unique([mailId, employeeId])
  @@unique([mailId, charityUserId])
  @@index([employeeId, isDeleted, isRead])
  @@index([charityUserId, isDeleted, isRead])
  @@index([mailId])
}

model MailAttachment {
  id       String       @id @default(uuid())
  mailId   String
  mail     InternalMail @relation(fields: [mailId], references: [id], onDelete: Cascade)
  fileUrl  String
  fileName String
  fileSize Int?

  @@index([mailId])
}

/// اسم النوع في القاعدة بقي "KnowledgeNodeKind": إعادة تسمية نوع تعداد في
/// Postgres عملية DDL على بيانات حيّة، ولا تشتري شيئاً — @@map يجعل الشيفرة
/// تقرأ بالاسم الجديد والقاعدة تبقى كما هي.
enum TemplateNodeKind {
  FOLDER
  FILE

  @@map("KnowledgeNodeKind")
}

/// عقدة في «مكتبة النماذج»: مجلد أو ملف.
///
/// شجرة واحدة عامة لموظفي زاد، غير تابعة لجمعية — الجذر هو الصفوف التي
/// `parentId` فيها null، والتعشيش بلا حدّ تمامًا كمتصفح الملفات.
///
/// النسخة السابقة من هذه الفكرة كانت تحفظ في `localStorage`، فكانت المجلدات
/// موجودة في متصفح من أنشأها وحده ولا يراها زملاؤه. الجدول هنا هو الفرق
/// الجوهري بين الفكرتين، لا الواجهة.
model TemplateNode {
  id   String           @id @default(uuid())
  name String
  kind TemplateNodeKind

  /// null للعقد في الجذر. الحذف متتالٍ: حذف مجلد يحذف ذريته كلها في
  /// قاعدة البيانات، ويبقى على الإجراء أن يزيل ملفاتها من Cloudinary قبل ذلك.
  parentId String?
  parent   TemplateNode?  @relation("TemplateLibrary", fields: [parentId], references: [id], onDelete: Cascade)
  children TemplateNode[] @relation("TemplateLibrary")

  // ── حقول الملفات وحدها؛ كلها null للمجلد ──────────────────────────────
  fileUrl      String?
  /// يلزم لحذف الأصل من Cloudinary لاحقًا.
  publicId     String?
  /// Cloudinary يحتاج النوع نفسه عند الحذف، وإلا افترض "image" ولم يحذف شيئًا.
  resourceType String?
  fileSize     Int?

  createdById String?
  createdBy   Employee? @relation("TemplateNodes", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  /// الجدول نفسه لم يُعَد تسميته — الاسم الجديد في الشيفرة وحدها، فلا هجرة
  /// ولا لحظة يكون فيها الجدول باسمٍ والشيفرة المنشورة باسمٍ آخر.
  @@map("KnowledgeNode")
}

// ── طلبات التصاميم ───────────────────────────────────────────────────────────

enum DesignRequestStatus {
  PENDING // قيد التنفيذ / في الطابور
  COMPLETED // منجز
  // ملحقتان في الآخر عمداً: إضافة قيمة لنوع تعداد في Postgres عملية رخيصة،
  // أما إعادة ترتيب القيم فتستلزم إعادة بناء النوع على بيانات حيّة.
  UNDER_REVIEW // قيد المراجعة — رفعته الجمعية وينتظر اعتماد موظف زاد
  REJECTED // مرفوض مع سبب مكتوب
  AWAITING_REVIEW // سُلّم وبانتظار ردّ الجمعية خلال 24 ساعة
  REVISION_REQUESTED // أعادته الجمعية بملاحظات، وزاد تعدّل خلال 24 ساعة
}

/// نوع التصميم وعدد أيام العمل الخاصة به — يديره موظف زاد من صفحة طلبات التصاميم.
///
/// تعديل `workingDays` لاحقاً لا يمسّ الطلبات القائمة إطلاقاً: مواعيدها محسوبة
/// ومجمّدة عند الإنشاء (انظر DesignRequest أدناه)، وعدد الأيام المستعمل وقتها
/// محفوظ في `baseWorkingDays`. النوع الجديد يسري على الطلبات الجديدة وحدها.
model DesignType {
  id          String  @id @default(uuid())
  name        String  @unique
  workingDays Int
  /// يُعطَّل ولا يُحذف: الطلبات السابقة تشير إليه، وسجلّها يجب أن يظل قادراً على
  /// قول أي نوع كانت.
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  requests DesignRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model DesignRequest {
  id          String              @id @default(uuid())
  /// جهةُ الطلب — جمعيةٌ متعاقدة أو «شركة زاد» نفسها.
  ///
  /// وكان الغياب (NULL) هو ما يعني «لزاد»، تفادياً لصفٍّ يظهر في كل قائمة
  /// جمعيات. ثم صارت زاد صفّاً حقيقياً بعلامة `isInternal` من أجل
  /// الاستراتيجية وتنمية الموارد — وهما يلزمان `charityId` — والاستثناءُ
  /// مجموعٌ في موضعٍ واحد: `EXTERNAL_CHARITIES` في `src/lib/charityScope.ts`.
  ///
  /// فنُقلت الطلبات إليه وصار العمود إلزامياً: معنىً ثانٍ للغياب يُنسى عند
  /// أوّل استعلام، ولا قيدَ فريداً يحرسه إذ `NULL ≠ NULL` في Postgres.
  charityId   String
  charity     Charity             @relation(fields: [charityId], references: [id], onDelete: Cascade)
  title       String
  description String?             @db.Text
  status      DesignRequestStatus @default(PENDING)

  /// أنواع التصميم المختارة. يجوز اختيار أكثر من نوع، ومجموع أيامها هو
  /// `baseWorkingDays`.
  types DesignType[]

  /// عدد أيام العمل المستعمل فعلاً عند حساب الموعد، مثبَّتاً وقت الإنشاء.
  /// وجوده يجعل الموعد قابلاً للتفسير بعد شهور، ويحمي الطلب من تعديل لاحق على
  /// أيام النوع.
  baseWorkingDays Int @default(3)
  /// أيام أضافها موظف زاد بعد الرفع. تُزاد على المدة ولا تمسّ تاريخ البدء —
  /// فصلها عن `baseWorkingDays` هو ما يُبقي الأصل والتمديد مقروءين معاً.
  addedDays       Int @default(0)

  // جدولة الطابور — تُحسب مرة واحدة عند الإنشاء ولا يُعاد حسابها أبداً بعد ذلك،
  // حتى لو أُنجز طلب سابق قبل موعده. لا تُضف منطق إعادة جدولة هنا.
  submittedAt            DateTime @default(now())
  scheduledStartDate     DateTime
  expectedCompletionDate DateTime

  /// When a Zad designer actually picked this up.
  ///
  /// Null means it is still only queued — and that is exactly the window in
  /// which the charity may still edit its own brief. Once work has begun,
  /// editing the brief underneath the designer is how two people end up
  /// building different things, so the portal closes it and says who to call.
  startedAt   DateTime?
  startedById String?
  startedBy   Employee? @relation("StartedDesignRequests", fields: [startedById], references: [id], onDelete: SetNull)

  completedAt    DateTime?
  completedById  String?
  completedBy    Employee? @relation("CompletedDesignRequests", fields: [completedById], references: [id], onDelete: SetNull)
  /// Free-text note staff may leave when delivering — either the first
  /// hand-off (to AWAITING_REVIEW) or the final one after a revision round.
  /// A second delivery overwrites the first: it describes the CURRENT
  /// hand-off, and the full history of what was said at each one already
  /// lives in DesignRequestEvent.
  completionNote String?   @map("completionNotes") @db.Text

  // ── المراجعة قبل دخول الطابور ──────────────────────────────────────────
  // طلب الجمعية يبدأ UNDER_REVIEW ولا يحجز مكاناً في الطابور، لأن
  // computeSchedule لا يحسب إلا صفوف PENDING. عند الاعتماد يُعاد حساب الموعد
  // على الطابور كما هو لحظتَها لا كما كان وقت الرفع — وهذا هو معنى «تأكيد
  // الموعد»: ما رأته الجمعية عند الرفع تقدير، وما بعد الاعتماد التزام.
  // ── مراجعة الجمعية بعد التسليم ─────────────────────────────────────────
  // «إنهاء» لم يعد نهائياً: الطلب يذهب للجمعية 24 ساعة والمرفقات تبقى. الحذف
  // من Cloudinary لا يقع إلا عند الاعتماد النهائي — يدوياً أو تلقائياً أو بعد
  // جولة التعديل الوحيدة.
  //
  // الحالتان AWAITING_REVIEW و REVISION_REQUESTED خارج ترتيب التنفيذ بحكم
  // البناء: computeSchedule لا يحسب إلا صفوف PENDING.

  /// متى سُلّم — منه تُحسب مهلة الـ24 ساعة الممنوحة للجمعية.
  deliveredAt         DateTime?
  /// متى أعادته الجمعية — منه تُحسب مهلة التعديل.
  revisionRequestedAt DateTime?
  /// ملاحظات الجمعية. حقل واحد لا جدول، لأن التعديل مسموح مرة واحدة فقط
  /// فلا تاريخ جولات يُحفظ.
  revisionNotes       String?   @db.Text
  /// اعتُمد بمرور المهلة لا بفعل الجمعية — يُعرض للطرفين.
  autoApproved        Boolean   @default(false)
  /// أغلقه موظف زاد بملاحظاته دون تنفيذ تعديلات الجمعية.
  ///
  /// COMPLETED وحدها لا تفرّق بين تسليم اعتُمد وطلب أُقفل بملاحظة، والجمعية
  /// أحقّ الناس بمعرفة أيّ النهايتين وقعت لطلبها.
  closedWithNotes     Boolean   @default(false)

  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      Employee? @relation("ReviewedDesignRequests", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// سبب الرفض كما كتبه الموظف. تراه الجمعية في تبويب «المرفوضة».
  rejectionReason String?   @db.Text

  // مصدر الطلب: أحد الحقلين فقط يكون مُعبّأً
  charityUserId       String?
  charityUser         CharityUser? @relation("SubmittedDesignRequests", fields: [charityUserId], references: [id], onDelete: SetNull)
  createdByEmployeeId String?
  createdByEmployee   Employee?    @relation("CreatedDesignRequests", fields: [createdByEmployeeId], references: [id], onDelete: SetNull)

  // ── الأرشيف ─────────────────────────────────────────────────────────────
  /// متى أُرشِف — وهي علامةٌ مستقلّةٌ عن الحالة لا حالةٌ سابعة.
  ///
  /// فالحالةُ تقود دورة العمل كلَّها: الموعدَ والتسليمَ ومراجعةَ الجمعية.
  /// وجعلُ الأرشيف حالةً يُنسي الطلبَ ما كان عليه ويُلزمنا حقلاً ثانياً
  /// نُعيده منه. فالمؤرشفُ يُخرَج من القوائم ومن حساب الطابور، وحالتُه كما
  /// هي — وإلغاءُ الأرشفة يُعيده إلى ما كان، وإن كان `PENDING` دخل الدور
  /// من جديد بموعدٍ يُحسب لحظتَها.
  archivedAt     DateTime?
  /// من أرشفه — منسوخاً لا مرتبطاً، كفاعل `DesignRequestEvent`: قد يكون
  /// موظفاً أو مستخدمَ جمعية، والحسابُ قد يُحذف أو يُعاد تسميته.
  archivedByType AuditActorType?
  archivedById   String?
  archivedByName String?

  attachments DesignRequestAttachment[]
  extensions  DesignRequestExtension[]
  events      DesignRequestEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([charityId, status])
  @@index([status])
  @@index([scheduledStartDate])
  /// قوائمُ الصفحتين كلُّها «جهةٌ + أرشيف».
  @@index([charityId, archivedAt])
}

/// سبب كل تمديد على حدة — لا حقل واحد يُكتب فوقه.
///
/// الجمعية ترى هذه القائمة في صفحة طلباتها، فهي تفسير موعد التسليم لا مجرد
/// أثر داخلي: الطلب الذي تأخّر مرتين له سببان، ودمجهما في نص واحد يخفي أن
/// التأخير حدث مرتين.
model DesignRequestExtension {
  id            String        @id @default(uuid())
  requestId     String
  request       DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  /// أيام العمل المضافة في هذه المرة تحديداً.
  days          Int
  reason        String        @db.Text
  /// موظف زاد الذي أضافها. تُترك بلا علاقة حتى يبقى السبب ظاهراً للجمعية حتى
  /// لو حُذف الحساب لاحقاً.
  createdById   String?
  createdByName String?
  createdAt     DateTime      @default(now())

  @@index([requestId, createdAt])
}

/// ما الذي يمثّله المرفق — وهو ما يقرّر مصيره عند إنهاء الطلب.
/// What happened to a design request, in order, from submission to sign-off.
///
/// Separate from AuditLog on purpose: that table is a security record read by
/// administrators, while this one is shown to the charity that owns the
/// request. Different audience, different retention, different wording.
model DesignRequestEvent {
  id        String        @id @default(uuid())
  requestId String
  request   DesignRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  kind DesignEventKind

  /// Who did it, copied rather than joined. The account may later be renamed
  /// or deleted, and a history that rewrites itself is not a history.
  actorType AuditActorType?
  actorId   String?
  actorName String?

  /// Shown under the entry: a reason, a note, or what changed.
  note String? @db.Text

  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
}

enum DesignEventKind {
  CREATED // رفع الطلب
  APPROVED // اعتماد زاد للطلب ودخوله الطابور
  REJECTED // رفض مع سبب
  RESUBMITTED // إعادة رفع بعد الرفض
  EDITED // تعديل الوصف أو المرفقات
  RESCHEDULED // تغيير تاريخ البدء لهذا الطلب وحده
  QUEUE_REORDERED // إعادة ترتيب طابور الجمعية
  EXTENDED // تمديد المدة
  STARTED // بدء التنفيذ
  DELIVERED // تسليم أولي بانتظار رد الجمعية
  REVISION_REQUESTED // ملاحظات من الجمعية
  CHARITY_APPROVED // اعتماد الجمعية للتسليم
  AUTO_APPROVED // اعتماد تلقائي بعد ٢٤ ساعة
  COMPLETED // إغلاق نهائي
  REVISION_RETURNED // أعاد زاد الطلب للجمعية بملاحظات والطلب ما زال مفتوحاً
  CLOSED_WITH_NOTES // أغلقه زاد بملاحظاته دون تنفيذ التعديلات
  ARCHIVED // نُقل إلى الأرشيف وخرج من الدور
  UNARCHIVED // أُخرج من الأرشيف وعاد إلى الدور بموعدٍ جديد
}

enum DesignAttachmentKind {
  /// ملفات الجمعية المرفقة مع الطلب. تُحذف من التخزين عند الإنهاء، لأنها مواد
  /// إدخال انتهى الغرض منها ولا داعي لإبقائها تستهلك مساحة.
  BRIEF
  /// الملف النهائي الذي يرفعه موظف زاد عند التسليم. يبقى — فهو ناتج العمل،
  /// والجمعية تحتاج تنزيله بعد الإنهاء لا قبله.
  DELIVERABLE
}

model DesignRequestAttachment {
  id           String               @id @default(uuid())
  requestId    String
  request      DesignRequest        @relation(fields: [requestId], references: [id], onDelete: Cascade)
  kind         DesignAttachmentKind @default(BRIEF)
  fileUrl      String
  publicId     String
  resourceType String               @default("raw") // "raw" | "image" | "video" — مطلوب لنجاح حذف الملف من Cloudinary
  fileName     String
  fileSize     Int?
  createdAt    DateTime             @default(now())

  @@index([requestId])
  @@index([requestId, kind])
}

// ── سجل التدقيق (Audit Log) ─────────────────────────────────────────────────
// لا توجد أي عملية تعديل أو حذف مبنية على هذا الجدول عمداً — السجلات للقراءة
// فقط من داخل التطبيق، حماية لها من التلاعب.
enum AuditActorType {
  EMPLOYEE
  CHARITY_USER
  SYSTEM
}

model AuditLog {
  id         String         @id @default(uuid())
  actorType  AuditActorType
  actorId    String?
  actorName  String?
  action     String // "LOGIN_SUCCESS" | "LOGIN_FAILED" | "LOGOUT" | "PERMISSION_CHANGE" | "DELETE" | "CREATE" | "FILE_UPLOAD"
  targetType String? // e.g. "Employee", "RoleDefinition", "DonorAccount"
  targetId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime       @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// الحضور والانصراف — Attendance
// ---------------------------------------------------------------------------

/// نوع إجازة الموظف. `ANNUAL` وحدها هي التي تُخصم من الرصيد السنوي — المرضية
/// وغيرها تمنع احتساب الغياب لكنها لا تستهلك رصيداً.
enum LeaveType {
  ANNUAL // سنوية
  SICK // مرضية
  UNPAID // بدون راتب
  OTHER // أخرى
}

/// إجازة تخصّ الجمعية كلها: عيد، يوم وطني، تعطيل استثنائي.
///
/// مدى لا يوم واحد، لأن العيد أيام لا يوم. اليوم المفرد يُخزَّن بـ start = end.
/// التواريخ مراسٍ منتصف ليل UTC ليوم الرياض المدني، كسائر تواريخ الحضور.
/// إجازة موظف بعينه.
///
/// `charityId` جزء من السجل لا تفصيلاً: الموظف قد يخدم جمعيتين، وإجازته من
/// إحداهما لا تعني غيابه مبرَّراً في الأخرى.
model EmployeeLeave {
  id            String      @id @default(uuid())
  charityUserId String
  user          CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charityId     String
  charity       Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)

  type      LeaveType @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  note      String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([charityId, startDate])
  @@index([charityUserId, startDate])
}

enum AttendanceStatus {
  PRESENT // حاضر
  LATE // متأخر
  EARLY_LEAVE // انصراف مبكر
  ABSENT // غائب
}

/// How a mismatch against Charity.allowedIpRanges is handled.
/// OFF   — layer disabled (also the effective behaviour when the list is empty).
/// WARN  — check-in succeeds but is flagged isSuspicious for human review.
/// BLOCK — check-in is refused unless the request comes from the charity network.
enum IpEnforcementMode {
  OFF
  WARN
  BLOCK
}

/// A physical location employees may check in from.
model CharityWorkSite {
  id           String   @id @default(uuid())
  charityId    String
  charity      Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(150)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  attendance AttendanceRecord[]

  @@index([charityId, isActive])
}

/// Working hours/days for a charity. One row per charity.
model CharityWorkSchedule {
  id                      String  @id @default(uuid())
  charityId               String  @unique
  charity                 Charity @relation(fields: [charityId], references: [id], onDelete: Cascade)
  startTime               String  @default("08:00") // Riyadh local, "HH:MM"
  endTime                 String  @default("16:00")
  lateAfterMinutes        Int     @default(15)
  earlyLeaveBeforeMinutes Int     @default(15)
  workDays                Int[]   @default([0, 1, 2, 3, 4]) // Sunday(0)..Thursday(4)

  /// متى فُتح التحضير في هذه الجمعية. `null` يعني مغلقاً — وهي الحالة الابتدائية.
  ///
  /// حقل واحد يؤدي دورين لأنهما في الحقيقة سؤال واحد:
  ///  1. البوابة — لا يُقبل تسجيل حضور ما لم يفتحه صاحب صلاحية manage_attendance،
  ///     فلا تبدأ جمعية بجمع بيانات موقع موظفيها لمجرد أن الميزة نُشرت.
  ///  2. بداية احتساب الغياب — الغياب مشتقّ لا مخزَّن، ويُحسب من هذا التاريخ فقط.
  ///     فالأيام التي سبقت الفتح لا تُحتسب غياباً على أحد، وهذا ما يمسح الغيابات
  ///     الوهمية المتراكمة قبل التفعيل.
  ///
  /// الإغلاق يُعيده إلى `null`، أي يمسح خط البداية أيضاً: إعادة الفتح تبدأ
  /// الاحتساب من جديد. مقصود — فترة الإغلاق ليست غياباً، ولا يصح أن تُحتسب.
  attendanceOpenedAt DateTime?

  /// رصيد الإجازة السنوية الافتراضي لكل موظف، بأيام العمل. يمكن تجاوزه لموظف
  /// بعينه من CharityUserCharity.annualLeaveDays.
  annualLeaveDays Int @default(21)

  updatedAt DateTime @updatedAt
}

/// One row per employee per charity per civil (Riyadh) day.
///
/// The charity is part of the key, not just a column: an account may serve
/// several charities, and each of them tracks that person's attendance
/// independently. Keying on (employee, day) alone made one charity's check-in
/// suppress every other charity's for the rest of the day.
///
/// The composite unique key is also what makes a duplicate check-in
/// structurally impossible, rather than relying on application logic that two
/// concurrent requests could race past.
/// أوقات دوام مجموعة من الموظفين.
///
/// Groups rather than one company schedule, because part-time and shift work
/// are ordinary. Everything that is genuinely company-wide — the attendance
/// gate and the IP policy — lives in ZadAttendanceSettings instead, so the
/// two do not get edited as if they were one thing.
model ZadShiftGroup {
  id                      String @id @default(uuid())
  name                    String @unique
  startTime               String @default("08:00") // Riyadh local, "HH:MM"
  endTime                 String @default("16:00")
  lateAfterMinutes        Int    @default(15)
  earlyLeaveBeforeMinutes Int    @default(15)
  workDays                Int[]  @default([0, 1, 2, 3, 4]) // Sunday(0)..Thursday(4)

  /// Where anyone unassigned lands. Exactly one row may hold it — enforced by
  /// a partial unique index, since Prisma cannot express "unique where true".
  isDefault Boolean @default(false)

  members   Employee[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

/// إعدادات التحضير على مستوى الشركة — صفّ واحد.
model ZadAttendanceSettings {
  id String @id @default("singleton")

  /// Null means attendance has never been switched on; nothing may be
  /// recorded before it is.
  attendanceOpenedAt DateTime?

  allowedIpRanges String[]          @default([])
  ipEnforcement   IpEnforcementMode @default(OFF)

  updatedAt DateTime @updatedAt
}

model ZadWorkSite {
  id           String  @id @default(uuid())
  name         String
  latitude     Float
  longitude    Float
  radiusMeters Int     @default(150)
  isActive     Boolean @default(true)

  attendance ZadAttendanceRecord[]
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  @@index([isActive])
}

model ZadAttendanceRecord {
  id         String       @id @default(uuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  workSiteId String?
  workSite   ZadWorkSite? @relation(fields: [workSiteId], references: [id], onDelete: SetNull)

  workDate DateTime

  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  checkInDistance Float?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutDistance Float?

  status AttendanceStatus @default(PRESENT)

  /// Recorded away from any work site, under remoteWorkAllowed.
  isRemote Boolean @default(false)

  ipAddress        String?
  userAgent        String?
  isSuspicious     Boolean @default(false)
  suspiciousReason String?

  manualAt     DateTime?
  manualById   String?
  manualReason String?

  /// Set by the nightly sweep on a day that was opened and never closed. Every
  /// screen renders it as "أُغلق تلقائياً", so the time reads as the assumption
  /// it is rather than an observed departure.
  autoClosedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // No nullable column in this key, so it actually prevents a second row for
  // the same day — unlike the charity table, where a NULL would slip through.
  @@unique([employeeId, workDate])
  @@index([workDate])
  @@index([employeeId, workDate])
  @@index([autoClosedAt])
}

model ZadEmployeeLeave {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      LeaveType @default(ANNUAL)
  startDate DateTime
  endDate   DateTime
  note      String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([employeeId, startDate])
}

/// التقويم — عطل رسمية وإغلاقات، لكل الجهات.
///
/// Deliberately has no charityId: one calendar serves Zad and, when charity
/// attendance returns, the charities too. It replaces CharityHoliday, which
/// was per-charity and held no rows.
///
/// A holiday of either scope is a non-working day and is never deducted from
/// anyone's leave balance. Only a personal ZadEmployeeLeave of type ANNUAL is.
model Holiday {
  id        String   @id @default(uuid())
  name      String
  startDate DateTime
  endDate   DateTime

  /// GLOBAL  — official, shown to everyone including charities later.
  /// COMPANY — a Zad-only closure, kept out of the shared calendar.
  ///
  /// The two behave identically in every calculation. The field exists so a
  /// Zad closure cannot leak into eight charities' calendars — a difference
  /// of audience, not of arithmetic, which is why it is a field and not a
  /// second table whose two counting rules would drift apart.
  scope HolidayScope @default(GLOBAL)

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startDate])
  @@index([scope, startDate])
}

enum HolidayScope {
  GLOBAL // عطلة رسمية — للجميع
  COMPANY // إغلاق خاص بزاد
}

model AttendanceRecord {
  id            String           @id @default(uuid())
  charityUserId String
  user          CharityUser      @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charityId     String
  charity       Charity          @relation(fields: [charityId], references: [id], onDelete: Cascade)
  workSiteId    String?
  workSite      CharityWorkSite? @relation(fields: [workSiteId], references: [id], onDelete: SetNull)

  /// UTC-midnight anchor of the Riyadh calendar day, computed on the SERVER.
  /// Never taken from the client clock — that would let a user back-date an
  /// attendance by changing their phone's date.
  workDate DateTime

  checkInAt       DateTime?
  checkInLat      Float?
  checkInLng      Float?
  checkInAccuracy Float?
  checkInDistance Float?

  checkOutAt       DateTime?
  checkOutLat      Float?
  checkOutLng      Float?
  checkOutAccuracy Float?
  checkOutDistance Float?

  status AttendanceStatus @default(PRESENT)

  // Review / forensics trail
  ipAddress        String?
  userAgent        String?
  isSuspicious     Boolean @default(false)
  suspiciousReason String?

  /// Set when a manager entered or amended this row by hand, which is the only
  /// way to record attendance the GPS could not confirm — a failed fix indoors
  /// must not cost an employee a day they actually worked.
  ///
  /// Non-null is the flag as well as the timestamp: every screen that shows a
  /// record must label it, because a hand-entered row carries no location
  /// evidence at all and must never be mistaken for a verified check-in. The
  /// coordinate columns stay null for exactly that reason.
  manualAt     DateTime?
  /// CharityUser who made the correction. Deliberately not a relation: the row
  /// should survive that account being deleted, and the full actor detail lives
  /// in the audit log.
  manualById   String?
  /// Required from the manager, and shown alongside the record.
  manualReason String?

  /// Set by the nightly job when a day ended with a check-in and no check-out.
  ///
  /// The job writes the schedule's end time into `checkOutAt` so the day stops
  /// hanging open, but that time is an assumption, not an observation — this
  /// column is what says so. Every screen showing the record must label it, and
  /// it is also the signal the HR alert counts, so a manager can see who keeps
  /// forgetting and correct the ones that matter.
  autoClosedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([charityUserId, charityId, workDate])
  @@index([charityId, workDate])
  // Serves both the nightly sweep (find open days) and the HR alert (count
  // auto-closed ones) without scanning the table.
  @@index([charityId, autoClosedAt])
  // Cross-charity, for the impossible-travel check, which deliberately looks at
  // the person's movements everywhere rather than only within one charity.
  @@index([charityUserId, workDate])
}

/// ربط صلاحية بخدمة: من مُنح الخدمة نال الصلاحية في جلسته التالية.
///
/// يُحرَّر يدوياً من لوحة الصلاحية في صفحة «الصلاحيات» وحدها، لا في الكود —
/// فالخدمات تُنشأ وتُسمّى وتُحذف يدوياً، وربطٌ ثابتٌ في الشيفرة ينكسر بصمت.
/// ويُخزَّن بالاسم لا بالمعرّف: الخدمة الواحدة صفٌّ في كل جمعية، والاسم هو
/// المفتاح الذي يستعمله EmployeeServiceAccess أصلاً. إعادة التسمية العامّة
/// تُحدّث هذه الصفوف، وحذف الخدمة يحذفها.
model PermissionServiceLink {
  permissionId String
  serviceName  String
  createdAt    DateTime @default(now())

  @@id([permissionId, serviceName])
  @@index([serviceName])
}

/// تفويض عضو الجمعية بخدمةٍ من خدمات زاد.
///
/// تبويبات البوابة تُربط بخدمات من صفحة «الصلاحيات» عند زاد (PermissionServiceLink)،
/// فلا يرى التبويب إلا من فُوِّض خدمته. ومدير الجمعية يمرّ بلا تفويض.
/// ويُخزَّن بالاسم لا بالمعرّف، كبقية منوحات الخدمات في النظام.
model CharityMemberService {
  membershipId String
  serviceName  String
  grantedAt    DateTime @default(now())

  membership CharityUserCharity @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([membershipId, serviceName])
  @@index([serviceName])
}

/// معمِّد بريد خدمةٍ في زاد.
///
/// البريد الصادر من زاد إلى جمعيةٍ باسم خدمةٍ لها معمِّد لا يُسلَّم حتى يعتمده.
/// ونطاقه جمعياته المسنَدة وحدها، فلا يرى بريد جمعيةٍ ليست له.
model MailApprover {
  employeeId  String
  serviceName String
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceName])
  @@index([serviceName])
}

/// معمِّد البريد الصادر من جمعية.
///
/// يعمل فقط حين تُفعّل الجمعية Charity.mailRequiresApproval، ونطاقه صادر
/// جمعيته كله — لا يُقسَّم بالخدمات كجهة زاد.
model CharityMailApprover {
  charityUserId String
  charityId     String
  createdAt     DateTime @default(now())

  user    CharityUser @relation(fields: [charityUserId], references: [id], onDelete: Cascade)
  charity Charity     @relation(fields: [charityId], references: [id], onDelete: Cascade)

  @@id([charityUserId, charityId])
  @@index([charityId])
}

// ════════════════════════════════════════════════════════════════════════════
//  التخطيط الاستراتيجي — الخطة في docs/خطة-نظام-التخطيط-الاستراتيجي.md
//
//  الهيكل: الجمعية ← المحور (البعد) ← الهدف ← المؤشر ← نتيجةٌ لكل (سنة، فترة).
//  وإلى جانبه: خطةٌ تشغيلية ← مبادرة ← خطوة تنفيذ.
//
//  وقاعدتان حكمتا التصميم:
//
//  ١) الربط بـcharityId لا بالاسم. الجداول الثلاثة القديمة (SurveyResponse،
//     HexagonalResponse، PerformanceMetric) تربط بالاسم نصاً، وبياناتها متخالفة
//     فعلاً: ردود الرؤية باسم «جمعية المعاقد التعليمية» وردود الجاهزية باسم
//     «المعاقد التعليمية»، و«جمعية ضماد الإسعافية » بمسافةٍ زائدة إلى جانب
//     «ضماد الإسعافية». فأيُّ جمعٍ على الاسم يفوته جزءٌ من البيانات.
//
//  ٢) ما يُحسب لا يُخزَّن. فلا عمود لحالة المبادرة ولا للأيام المتبقية ولا
//     للانحراف ولا لنِسب الإنجاز ولا لأداء الهدف والمحور والجمعية — تُشتقّ كلها
//     في العرض من دالّتين خالصتين. وفي ملف Excel المصدر صفوفٌ تحمل «متعثرة»
//     منسوخةً ساكنة، وهذا ما أردنا اجتنابه.
// ════════════════════════════════════════════════════════════════════════════

/// حالات الخطة الاستراتيجية التي يُختار منها في صفحة الجمعية. قائمةٌ تُدار من
/// الواجهة لا ثوابتَ في الكود: إضافةُ حالةٍ أو تغييرُ اسمها بيانات، لا نشرة.
model StrategyStatusOption {
  id        String   @id @default(uuid())
  name      String   @unique
  /// نبرة الشارة: muted | warn | good | danger — من نبرات Badge القائمة، فلا لونَ جديد.
  tone      String   @default("muted")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
}

/// المحور الاستراتيجي — يسمّيه ملف الجمعية «البعد»، ويسمّيه جدول مقياس الأداء
/// «المحور». الحقل واحد، والتسمية تختلف في الصفحتين عن قصد.
model StrategyPerspective {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  name      String
  /// بادئة رموز الأهداف: س ص م ل ت.
  prefix    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  objectives StrategyObjective[]

  @@unique([charityId, prefix])
  @@index([charityId, order])
}

model StrategyObjective {
  id            String              @id @default(uuid())
  perspectiveId String
  perspective   StrategyPerspective @relation(fields: [perspectiveId], references: [id], onDelete: Cascade)
  /// رمز الهدف كما في الوثيقة: «س 1».
  code          String
  name          String
  /// شرح الهدف — الفقرة الكاملة في دليل الأهداف.
  description   String?
  order         Int                 @default(0)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  indicators  StrategyIndicator[]
  initiatives Initiative[]

  @@unique([perspectiveId, code])
  @@index([perspectiveId, order])
}

model StrategyIndicator {
  id           String            @id @default(uuid())
  objectiveId  String
  objective    StrategyObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  /// رمز المؤشر كما في الوثيقة: «س 1 - 1».
  code         String
  name         String
  description  String?
  /// وحدة القياس: مبادرة، مستفيدة، نسبة، ريال، تقرير، منصة...
  unit         String?
  formula      String?
  /// دورية القياس: ربع سنوي | نصف سنوي | سنوي.
  frequency    String?
  /// اتجاه التحسن المطلوب: UP للزيادة، DOWN للنقص.
  polarity     String            @default("UP")
  /// التراكمية، وهي مصدر قاعدة حساب المحقق السنوي لا وحدةُ القياس:
  ///   false («غير تراكمي») ← يبدأ المؤشر من الصفر كل ربع، فالسنوي مجموع الأرباع.
  ///   true  («تراكمي») ← القيمة مستوًى قائم يحتوي آخرُ قياسٍ له ما قبله،
  ///                      فالسنوي آخر ربعٍ له متحقق. وجمعُها يُخرج ٣٤٠٪.
  /// وهذا نصّ تعليمات ورقة «متابعة الأداء» في ملف الجمعية.
  cumulative   Boolean           @default(false)
  /// مالك المؤشر — العمود القائم في جدول مقياس الأداء.
  owner        String?
  execOwner    String?
  measureOwner String?
  /// خط الأساس: قيمة المؤشر قبل تنفيذ الخطة.
  baseline     Decimal?          @db.Decimal(18, 4)
  order        Int               @default(0)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  results     IndicatorResult[]
  initiatives InitiativeIndicator[]

  @@unique([objectiveId, code])
  @@index([objectiveId, order])
}

/// صفٌّ لكل (مؤشر، سنة، فترة). الفترة YEAR أو Q1..Q4 — أربعة أرباع لا اثنان،
/// والسنة حقلٌ لا ثابت: ملف ٢٠٢٦ ثبّت سنته وربعيه فصار مرتبطاً بهما.
model IndicatorResult {
  id          String            @id @default(uuid())
  indicatorId String
  indicator   StrategyIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)
  year        Int
  /// YEAR | Q1 | Q2 | Q3 | Q4
  period      String
  target      Decimal?          @db.Decimal(18, 4)
  actual      Decimal?          @db.Decimal(18, 4)
  /// ACTIVE | POSTPONED (يُستثنى من المتوسطات) | NO_DATA (يُحتسب صفراً).
  state       String            @default("ACTIVE")
  /// للفترة YEAR وحدها: متحققٌ أُدخل يدوياً فيتجاوز الحساب التراكمي، وتظهر
  /// معه علامةُ تجاوزٍ في الجدول كي لا يتغيّر رقمٌ أدخله الموظف بلا علمه.
  isOverride  Boolean           @default(false)
  note        String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([indicatorId, year, period])
  @@index([year, period])
}

/// فترة الخطة التشغيلية. منها وحدها يُشتقّ محور أسابيع مخطط جانت وأعمدة
/// الأشهر: رقمُ أسبوعٍ بلا تاريخِ بدايةٍ لا معنى له.
model OperationalPlan {
  id        String   @id @default(uuid())
  charityId String
  charity   Charity  @relation(fields: [charityId], references: [id], onDelete: Cascade)
  /// «أغسطس 2026 — ديسمبر 2026»
  label     String
  startDate DateTime
  endDate   DateTime
  weekCount Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  initiatives Initiative[]

  @@unique([charityId, label])
  @@index([charityId])
}

model Initiative {
  id            String             @id @default(uuid())
  planId        String
  plan          OperationalPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// رقم المبادرة في الكشاف (العمود «م»)، وهو مفتاح مسار صفحتها.
  number        Int
  name          String
  description   String?
  objectiveId   String?
  objective     StrategyObjective? @relation(fields: [objectiveId], references: [id], onDelete: SetNull)
  /// نصُّ المدة كما في الوثيقة: «18 أسبوعاً».
  durationText  String?
  managerName   String?
  owningDept    String?
  /// عالية | متوسطة | منخفضة — إدخالٌ يدوي، وهو العمود الوحيد في الكشاف
  /// الذي لا يُسحب من صفحة المبادرة.
  priority      String?
  startDate     DateTime?
  endDate       DateTime?
  budget        Decimal?           @db.Decimal(18, 2)
  /// توزيع الموازنة على أشهر الخطة: { "2026-08": 0, "2026-09": 18150, ... }
  /// مفاتيحه أشهرٌ لا أسماء، فلا يرتبط بفترةِ خطةٍ بعينها.
  monthlyBudget Json?

  /// الملف التسويقي للمبادرة: رابطٌ خارجي أو ملفٌ مرفوع إلى Cloudinary.
  ///
  /// الحالتان تنتهيان إلى رابطٍ يُفتح، فالعنوان واحد (`marketingUrl`) و`kind`
  /// يقول أصلَه: «LINK» لا يُحذف من Cloudinary، و«FILE» يُحذف أصلُه عند
  /// استبداله فلا تبقى ملفاتٌ يتيمةٌ تُحتسب في الحصة.
  marketingKind         String?
  marketingUrl          String?
  marketingFileName     String?
  /// يلزمان لحذف الأصل من Cloudinary: destroy يحتاج نوع المورد نفسه، وإلا
  /// افترض «image» ولم يفعل شيئاً مع الملفات الخام.
  marketingPublicId     String?
  marketingResourceType String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  steps      InitiativeStep[]
  indicators InitiativeIndicator[]

  @@unique([planId, number])
  @@index([planId])
  @@index([objectiveId])
}

/// المبادرة ترتبط بعدّة مؤشرات — الوثيقة تذكرها بالجمع. ويفتح هذا سؤالاً
/// نافعاً لاحقاً: ما المبادرات التي تخدم المؤشر المتعثّر؟
model InitiativeIndicator {
  initiativeId String
  indicatorId  String
  initiative   Initiative        @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  indicator    StrategyIndicator @relation(fields: [indicatorId], references: [id], onDelete: Cascade)

  @@id([initiativeId, indicatorId])
  @@index([indicatorId])
}

model InitiativeStep {
  id              String     @id @default(uuid())
  initiativeId    String
  initiative      Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  /// العمود «ت» في جدول الخطوات.
  order           Int
  /// الإعداد | التنفيذ | الإغلاق
  phase           String?
  title           String
  /// شاهد التنفيذ: الوثيقة التي تُثبت إنجاز الخطوة.
  evidence        String?
  owner           String?
  cost            Decimal?   @db.Decimal(18, 2)
  actualCost      Decimal?   @db.Decimal(18, 2)
  /// أرقام أسابيع نسبيّة إلى OperationalPlan.startDate، تبدأ من ١.
  planStartWeek   Int?
  planWeeks       Int?
  actualStartWeek Int?
  actualWeeks     Int?
  /// نسبة إنجاز الخطوة ٠-١٠٠. وهي المُدخل الوحيد، ومنها تُحسب نسبة المبادرة.
  progress        Int        @default(0)
  /// توزيع تكلفة الخطوة على الأشهر، بمفاتيح monthlyBudget نفسها.
  monthlyCost     Json?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([initiativeId, order])
}

// ════════════════════════════════════════════════════════════════════════════
//  الطلبات المالية — الخطة في docs/خطة-الطلبات-المالية.md
//
//  الطلب المالي صفُّ Request بنوع FINANCIAL، وتفاصيلُه المالية هنا. فيَرِث
//  السلسلةَ والسجلَّ والإشعارَ والتفويضَ كما هي، ولا يُكتب محرّكُ اعتمادٍ ثانٍ.
// ════════════════════════════════════════════════════════════════════════════

/// تفاصيل الطلب المالي — واحدٌ لكل طلب.
///
/// وفي جدولٍ مستقلٍّ لا أعمدةً على Request: تسعةُ حقولٍ تخصّ نوعاً واحداً من
/// الطلبات، فإضافتها هناك تُلزم كلَّ طلبٍ عامٍّ بحملها فارغة. والعلاقة
/// واحدٌ-لواحد فالقراءة ضمّةٌ واحدة.
model FinancialRequest {
  id        String  @id @default(uuid())
  requestId String  @unique
  request   Request @relation(fields: [requestId], references: [id], onDelete: Cascade)

  typeId    String?
  type      FinancialRequestType? @relation(fields: [typeId], references: [id], onDelete: SetNull)
  /// اسم النوع وقت الرفع، مثبَّتاً في الصفّ.
  ///
  /// والطلب المالي وثيقةٌ تُصدَّر وتُعتمد وتُختم، فتغييرُ مسمّى النوع في
  /// الإعدادات لا يجوز أن يُعيد كتابة ما اعتُمد. وهذا يخالف حالات الخطة
  /// الاستراتيجية (حيث يتبع التغييرُ حامليها) — لأن تلك حالةٌ راهنة وهذا سِجلّ.
  typeLabel String

  amount    Decimal  @db.Decimal(14, 2)
  isTaxable Boolean  @default(false)
  /// نسبة الضريبة وقت الرفع، مثبَّتةً كذلك. والمبلغُ الضريبي والإجمالي محسوبان
  /// لا مخزَّنين — من المبلغ والنسبة، بدالّةٍ واحدةٍ مختبَرة.
  taxRate   Decimal? @db.Decimal(5, 2)

  /// الحساب البنكي — كلُّه اختياري، ورقمُ الحساب اختياريٌّ حتى لو ذُكر البنك.
  bankName      String?
  iban          String?
  accountNumber String?

  /// رقمُ الوثيقة: يُعرض ZAD_FR_007 في الـPDF وفي القائمة.
  serial Int @unique @default(autoincrement())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([typeId])
}

/// أنواع الطلب المالي — بياناتٌ تُدار من إعدادات الصفحة لا ثوابتَ في الكود.
///
/// والحذفُ تعطيلٌ إن كان النوع مستعملاً: اسمٌ في وثيقةٍ معتمَدة لا يختفي.
model FinancialRequestType {
  id       String  @id @default(uuid())
  name     String  @unique
  order    Int     @default(0)
  isActive Boolean @default(true)

  requests  FinancialRequest[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([order])
}
